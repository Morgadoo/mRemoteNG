<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>mRemoteNG.ExternalProviders</RootNamespace>
    <AssemblyName>mRemoteNG.ExternalProviders</AssemblyName>
    <Description>mRemoteNG — external credential providers (Delinea Secret Server, Passwordstate, 1Password, Vault/OpenBao) and address providers (AWS EC2)</Description>
    <Version>1.78.2-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.EC2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mRemoteNG.Core\mRemoteNG.Core.csproj" />
    <ProjectReference Include="..\mRemoteNG.Platform\mRemoteNG.Platform.csproj" />
    <ProjectReference Include="..\mRemoteNG.Protocols\mRemoteNG.Protocols.csproj" />
    <!-- Plugin host (Plugins/): the net10.0 build of the contracts, without the WinForms tool-window interface. -->
    <ProjectReference Include="..\mRemoteNG.PluginContracts\mRemoteNG.PluginContracts.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="mRemoteNG.Tests.CrossPlatform" />
    <InternalsVisibleTo Include="mRemoteNG.Avalonia.Tests" />
  </ItemGroup>

</Project>
