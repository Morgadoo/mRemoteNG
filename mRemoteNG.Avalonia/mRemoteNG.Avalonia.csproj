<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>mRemoteNG.Avalonia</RootNamespace>
    <AssemblyName>mRemoteNG.Avalonia</AssemblyName>
    <Description>mRemoteNG — Cross-platform Avalonia UI</Description>
    <Version>1.78.2-dev</Version>
    <!-- Avalonia uses its own designer -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Avalonia packages -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />

    <!-- MVVM -->
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.Fody" />

    <!-- Docking layout (cross-platform DockPanelSuite replacement) -->
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />

    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />

    <!-- Icons -->
    <PackageReference Include="Material.Icons.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mRemoteNG.Core\mRemoteNG.Core.csproj" />
    <ProjectReference Include="..\mRemoteNG.Platform\mRemoteNG.Platform.csproj" />
    <ProjectReference Include="..\mRemoteNG.Protocols\mRemoteNG.Protocols.csproj" />
  </ItemGroup>

  <!-- Build and copy platform-specific assemblies for runtime Assembly.Load() -->
  <Target Name="BuildAndCopyPlatformAssemblies" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="..\mRemoteNG.Platform.Windows\mRemoteNG.Platform.Windows.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <_WinPlatformFiles Include="..\mRemoteNG.Platform.Windows\bin\$(Configuration)\net10.0-windows10.0.17763.0\mRemoteNG.Platform.Windows.dll" />
      <_WinPlatformFiles Include="..\mRemoteNG.Platform.Windows\bin\$(Configuration)\net10.0-windows10.0.17763.0\mRemoteNG.Platform.Windows.pdb" Condition="Exists('..\mRemoteNG.Platform.Windows\bin\$(Configuration)\net10.0-windows10.0.17763.0\mRemoteNG.Platform.Windows.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinPlatformFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Avalonia assets (icons, themes) embedded as resources -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="Themes/**" />
  </ItemGroup>

  <!-- Ensure AXAML code-behind files compile correctly -->
  <ItemGroup>
    <Compile Update="Views/**/*.axaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
