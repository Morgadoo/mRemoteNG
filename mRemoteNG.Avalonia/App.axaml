<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mRemoteNG.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <!-- Base Fluent theme (provides all control templates) -->
        <FluentTheme />
        <!-- The mRemoteNG palette (Themes/DarkTheme.axaml or LightTheme.axaml) is added by ThemeService
             at startup, before any window opens. It must not be declared here: the XAML compiler inlines
             a StyleInclude, so ThemeService could not find and replace it when the theme changes. -->
    </Application.Styles>

</Application>
