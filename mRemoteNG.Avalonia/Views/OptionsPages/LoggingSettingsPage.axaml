<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.LoggingSettingsPage"
             x:DataType="vm:LoggingSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{l:Tr Logging}" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Tr LogFile}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding LogToFile}" Content="{l:Tr WriteALogFile}"/>
                <Grid ColumnDefinitions="*,240" IsEnabled="{Binding LogToFile}">
                    <TextBlock Text="{l:Tr Level}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"/>
                </Grid>
                <Grid ColumnDefinitions="*,8,Auto" IsEnabled="{Binding LogToFile}">
                    <TextBox Text="{Binding LogFilePath}" TextWrapping="Wrap" Watermark="{Binding DefaultLogFilePath}"/>
                    <Button Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowse"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" Opacity="0.7"
                           Text="{l:Tr TheFileRollsOverAt10MB}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr OpenLogFileButton}" Click="OnOpenLogFile"/>
                    <Button Content="{l:Tr OpenFolder}" Click="OnOpenFolder"/>
                </StackPanel>
                <SelectableTextBlock Text="{Binding EffectiveLogFilePath}" Opacity="0.8" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr DataFolder}" Classes="section-header"/>
                <SelectableTextBlock Text="{Binding DataDirectoryInfo}" TextWrapping="Wrap"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.7"
                           Text="{l:Tr PortableModePutAnEmptyFileNamed}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
