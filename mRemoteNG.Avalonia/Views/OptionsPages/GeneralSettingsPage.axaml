<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.GeneralSettingsPage"
             x:DataType="vm:GeneralSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{l:Tr StartupExit, English='Startup &amp; Exit'}" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Tr Startup}" Classes="section-header"/>
                <Grid ColumnDefinitions="*,280">
                    <TextBlock Text="{l:Tr WhenMRemoteNGStarts}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding StartupChoices}"
                              SelectedItem="{Binding SelectedStartupChoice}"/>
                </Grid>
                <Grid ColumnDefinitions="*,8,Auto" IsEnabled="{Binding IsStartupFileEnabled}">
                    <TextBox Text="{Binding StartupFilePath}" Watermark="{l:Tr ConnectionFileToOpenAtStartup}"/>
                    <Button Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowseStartupFile"/>
                </Grid>
                <CheckBox IsChecked="{Binding SingleInstance}"
                          Content="{l:Tr AllowOnlyASingleInstanceOfMRemoteNG}"/>
                <CheckBox IsChecked="{Binding StartMinimized}"
                          Content="{l:Tr StartMinimisedToTheSystemTrayWhen}"/>
                <SelectableTextBlock Text="{Binding DataDirectoryInfo}" TextWrapping="Wrap" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Tr Exit}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding SaveConnectionsOnExit}"
                          Content="{l:Tr SaveTheOpenConnectionFileWhenExiting}"/>
                <Grid ColumnDefinitions="*,280">
                    <TextBlock Text="{l:Tr ConfirmClosingConnections}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ConfirmCloseChoices}"
                              SelectedItem="{Binding SelectedConfirmCloseChoice}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{l:Tr SystemTray}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding ShowTrayIcon}" Content="{l:Tr ShowAnIconInTheSystemTray}"/>
                <CheckBox IsChecked="{Binding MinimizeToTray}" IsEnabled="{Binding ShowTrayIcon}"
                          Content="{l:Tr MinimiseToTheSystemTray}"
                          ToolTip.Tip="{l:Tr RequiresADesktopEnvironmentWithASystem}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
