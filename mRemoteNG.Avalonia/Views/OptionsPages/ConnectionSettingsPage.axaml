<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.ConnectionSettingsPage"
             x:DataType="vm:ConnectionSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Connections" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Defaults" Classes="section-header"/>
                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,12,Auto,12,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Protocol" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding Protocols}"
                              SelectedItem="{Binding DefaultProtocol}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Connect Timeout (s)" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Value="{Binding ConnectTimeout}"
                                   Minimum="1" Maximum="120"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Default Port" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="4" Grid.Column="1"
                                   Value="{Binding DefaultPort}"
                                   Minimum="1" Maximum="65535"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Keep-Alive" Classes="section-header"/>
                <CheckBox IsChecked="{Binding KeepAlive}" Content="Enable keep-alive packets"/>
                <Grid ColumnDefinitions="*,120" IsEnabled="{Binding KeepAlive}">
                    <TextBlock Text="Interval (s)" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding KeepAliveInterval}"
                                   Minimum="10" Maximum="3600"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Reliability" Classes="section-header"/>
                <CheckBox IsChecked="{Binding AutoReconnect}" Content="Auto-reconnect on disconnect"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
