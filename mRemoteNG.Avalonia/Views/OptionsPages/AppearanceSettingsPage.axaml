<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.AppearanceSettingsPage"
             x:DataType="vm:AppearanceSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Appearance" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Theme" Classes="section-header"/>
                <Grid ColumnDefinitions="*,200">
                    <TextBlock Text="Color theme" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Font" Classes="section-header"/>
                <Grid ColumnDefinitions="*,200" RowDefinitions="Auto,12,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Font family" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FontFamily}" Watermark="(theme default)"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Font size" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Value="{Binding FontSize}"
                                   Minimum="8" Maximum="32" Increment="1" FormatString="0.#"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Layout" Classes="section-header"/>
                <CheckBox IsChecked="{Binding ShowToolbar}" Content="Show toolbar"/>
                <CheckBox IsChecked="{Binding ShowStatusBar}" Content="Show status bar"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
