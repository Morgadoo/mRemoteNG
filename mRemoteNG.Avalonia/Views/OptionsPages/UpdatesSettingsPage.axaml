<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.UpdatesSettingsPage"
             x:DataType="vm:UpdatesSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Updates" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Update Channel" Classes="section-header"/>
                <CheckBox IsChecked="{Binding AutoCheck}" Content="Automatically check for updates"/>
                <Grid ColumnDefinitions="*,180">
                    <TextBlock Grid.Column="0" Text="Update channel" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding UpdateChannel}"
                              IsEnabled="{Binding AutoCheck}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
