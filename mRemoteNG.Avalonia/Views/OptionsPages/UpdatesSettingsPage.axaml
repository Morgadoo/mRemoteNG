<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.UpdatesSettingsPage"
             x:DataType="vm:UpdatesSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{l:Tr Updates}" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Tr UpdateCheckSection}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding AutoCheck}"
                          Content="{l:Tr CheckForUpdatesAtStartupAtMost}"/>
                <Grid ColumnDefinitions="*,220">
                    <TextBlock Text="{l:Tr ReleasesToLookFor}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding SelectedChannel}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{l:Tr InstalledVersion}"/>
                        <Run Text="{Binding CurrentVersion}"/>
                    </TextBlock>
                    <Button Grid.Column="1" Content="{l:Tr CheckNow}" Command="{Binding CheckNowCommand}"/>
                </Grid>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                <SelectableTextBlock Text="{Binding ReleaseUrl}" IsVisible="{Binding HasReleaseUrl}"
                                     Foreground="{DynamicResource AccentBrush}"/>
                <Grid ColumnDefinitions="Auto,12,*" IsVisible="{Binding HasReleaseUrl}">
                    <Button Content="{l:Tr Download}" Command="{Binding DownloadCommand}"
                            ToolTip.Tip="{l:Tr DownloadsThePackageForThisSystemAnd}"/>
                    <TextBlock Grid.Column="2" Text="{Binding PackageName}" VerticalAlignment="Center" Opacity="0.8"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDownloadedFile}">
                    <Button Content="{l:Tr Open}" Click="OnOpenDownload"/>
                    <Button Content="{l:Tr ShowInFolder}" Click="OnRevealDownload"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Tr Proxy}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding UseProxy}" Content="{l:Tr UseAProxyForUpdateChecksAnd}"/>
                <Grid ColumnDefinitions="*,8,120" IsEnabled="{Binding UseProxy}">
                    <TextBox Text="{Binding ProxyAddress}" Watermark="proxy.example.com"/>
                    <NumericUpDown Grid.Column="2" FormatString="0" Minimum="1" Maximum="65535" Value="{Binding ProxyPort}"/>
                </Grid>
                <CheckBox IsChecked="{Binding ProxyUseAuthentication}" IsEnabled="{Binding UseProxy}" Content="{l:Tr TheProxyRequiresAUserNameAnd}"/>
                <Grid ColumnDefinitions="*,8,*" IsEnabled="{Binding ProxyUseAuthentication}">
                    <TextBox Text="{Binding ProxyUsername}" Watermark="{l:Tr Username, English='User name'}"/>
                    <TextBox Grid.Column="2" Text="{Binding ProxyPassword}" PasswordChar="•" Watermark="{l:Tr Password}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
