<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.TabsSettingsPage"
             x:DataType="vm:TabsSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Tabs" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Tab Behavior" Classes="section-header"/>
                <CheckBox IsChecked="{Binding ConfirmOnClose}" Content="Confirm before closing a tab"/>
                <CheckBox IsChecked="{Binding CloseOnDoubleClick}" Content="Close tab on double-click"/>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Tab Bar" Classes="section-header"/>
                <CheckBox IsChecked="{Binding ShowCloseButton}" Content="Show close button on each tab"/>
                <Grid ColumnDefinitions="*,180">
                    <TextBlock Grid.Column="0" Text="Tab bar position" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Positions}"
                              SelectedItem="{Binding TabPosition}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
