<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.CredentialsSettingsPage"
             x:DataType="vm:CredentialsSettingsViewModel">
    <StackPanel Classes="settings-page">
        <StackPanel Classes="page-title">
            <TextBlock Text="{l:Tr Credentials}" Classes="h1"/>
            <TextBlock Text="{l:Tr CredentialsAreStoredInYourSettingsFolder}" Classes="caption" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Classes="settings-group">
            <TextBlock Text="{l:Tr SavedCredentials}" Classes="h2"/>
            <Border Classes="settings">
                <ctl:SettingRow Header="{Binding Summary}" Description="{l:Tr CredentialsPageManageDescription}">
                    <Button Click="OnManageCredentials">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="KeyChainVariant"/>
                            <TextBlock Text="{l:Tr ManageCredentials, Suffix='…'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </ctl:SettingRow>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
