<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.CredentialsSettingsPage"
             x:DataType="vm:CredentialsSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Credentials" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Saved Credentials" Classes="section-header"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Credentials are stored in your settings folder. Passwords are encrypted with your operating system account (DPAPI on Windows, a private key file on Linux and macOS)."/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Manage credentials…" Click="OnManageCredentials"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
