<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.CredentialsSettingsPage"
             x:DataType="vm:CredentialsSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{l:Tr Credentials}" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Tr SavedCredentials}" Classes="section-header"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="{l:Tr CredentialsAreStoredInYourSettingsFolder}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{l:Tr ManageCredentials, Suffix='…'}" Click="OnManageCredentials"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
