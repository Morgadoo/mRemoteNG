<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.CredentialsSettingsPage"
             x:DataType="vm:CredentialsSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Credentials" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Default Credentials" Classes="section-header"/>
                <Grid ColumnDefinitions="*,180">
                    <TextBlock Grid.Column="0" Text="Default username" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding DefaultUsername}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Storage" Classes="section-header"/>
                <CheckBox IsChecked="{Binding SavePasswords}" Content="Save passwords in connections file"/>
                <CheckBox IsChecked="{Binding AskBeforeConnect}" Content="Ask for credentials before connecting"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
