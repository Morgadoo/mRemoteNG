<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.ExternalProvidersSettingsPage"
             x:DataType="vm:ExternalProvidersSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- Wrapping text would otherwise grow to the measure width and push the page past the window. -->
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="SelectableTextBlock.status">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
        </Style>
        <Style Selector="SelectableTextBlock.status.failed">
            <Setter Property="Foreground" Value="#E57373"/>
        </Style>
    </UserControl.Styles>

    <!-- The Options ScrollViewer measures this long page wider than it arranges it, and wrapping
         text (Fluent CheckBox content wraps) fills the measure width; cap it at the default page width. -->
    <StackPanel Spacing="16" MaxWidth="570" HorizontalAlignment="Left">
        <TextBlock Text="External Providers" FontSize="18" FontWeight="Bold"/>
        <TextBlock Classes="hint"
                   Text="Connections fetch their credentials from a secret store when their External Credential Provider is set (the secret ID or item reference goes in User via API), and their address from AWS when External Address Provider is AWS. Secrets you type here are saved encrypted for your user account; leave them empty to be asked once per session."/>

        <!-- Default provider -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Default Credential Provider" Classes="section-header"/>
                <TextBlock Classes="hint" Text="Used for connections without a username, an external provider or a default username."/>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,8,Auto">
                    <TextBlock Classes="label" Text="Provider"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding CredentialProviders}" SelectedItem="{Binding SelectedDefaultProvider}"/>
                    <TextBlock Grid.Row="2" Classes="label" Text="Secret ID / reference"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DefaultUserViaApi}"
                             IsEnabled="{Binding HasDefaultProvider}" Watermark="e.g. 42 or op://Vault/Item"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Delinea -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Delinea (Thycotic) Secret Server" Classes="section-header"/>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                    <TextBlock Classes="label" Text="Server URL"/>
                    <TextBox Grid.Column="1" Text="{Binding DelineaUrl}" Watermark="https://cred.domain.local/SecretServer"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding DelineaUseSso}"
                              Content="Windows integrated authentication (SSO)"/>
                    <TextBlock Grid.Row="4" Classes="label" Text="Username" IsEnabled="{Binding DelineaUsesLogin}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DelineaUsername}" IsEnabled="{Binding DelineaUsesLogin}"/>
                    <TextBlock Grid.Row="6" Classes="label" Text="Domain (optional)"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DelineaDomain}" IsEnabled="{Binding DelineaUsesLogin}"/>
                    <TextBlock Grid.Row="8" Classes="label" Text="Password"/>
                    <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,8,Auto" DataContext="{Binding DelineaPassword}"
                          x:DataType="vm:ProviderSecretViewModel" IsEnabled="{Binding CanSave}">
                        <TextBox Text="{Binding Value}" PasswordChar="●" Watermark="{Binding State}"/>
                        <Button Grid.Column="2" Content="Forget" Command="{Binding ForgetCommand}"/>
                    </Grid>
                </Grid>
                <CheckBox IsChecked="{Binding DelineaRequireOtp}" Content="Ask for a one-time password (OTP) at login"
                          IsEnabled="{Binding DelineaUsesLogin}"/>
                <StackPanel Spacing="6" DataContext="{Binding DelineaTest}" x:DataType="vm:ProviderTestViewModel">
                    <Button Content="Test" Command="{Binding TestCommand}" IsEnabled="{Binding IsAvailable}"/>
                    <SelectableTextBlock Classes="status" Classes.failed="{Binding Failed}" Text="{Binding Status}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Passwordstate -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Clickstudios Passwordstate" Classes="section-header"/>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,8,Auto,8,Auto">
                    <TextBlock Classes="label" Text="Server URL"/>
                    <TextBox Grid.Column="1" Text="{Binding PasswordstateUrl}" Watermark="https://passwordstate.domain.local"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding PasswordstateUseSso}"
                              Content="Windows integrated authentication (winapi)"/>
                    <TextBlock Grid.Row="4" Classes="label" Text="API key"/>
                    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,8,Auto" DataContext="{Binding PasswordstateApiKey}"
                          x:DataType="vm:ProviderSecretViewModel" IsEnabled="{Binding CanSave}">
                        <TextBox Text="{Binding Value}" PasswordChar="●" Watermark="{Binding State}"/>
                        <Button Grid.Column="2" Content="Forget" Command="{Binding ForgetCommand}"/>
                    </Grid>
                </Grid>
                <CheckBox IsChecked="{Binding PasswordstateRequireOtp}" Content="Ask for a one-time password (OTP) per request"/>
                <StackPanel Spacing="6" DataContext="{Binding PasswordstateTest}" x:DataType="vm:ProviderTestViewModel">
                    <Button Content="Test" Command="{Binding TestCommand}" IsEnabled="{Binding IsAvailable}"/>
                    <SelectableTextBlock Classes="status" Classes.failed="{Binding Failed}" Text="{Binding Status}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 1Password -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="1Password (op CLI)" Classes="section-header"/>
                <TextBlock Classes="hint" Text="References: op://Vault/Item?account=…, op://Vault/Item/field, or an item name. Sign-in is handled by the 1Password CLI (desktop app integration or OP_SERVICE_ACCOUNT_TOKEN)."/>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,8,Auto">
                    <TextBlock Classes="label" Text="CLI path"/>
                    <Grid Grid.Column="1" ColumnDefinitions="*,8,Auto">
                        <TextBox Text="{Binding OnePasswordCliPath}" Watermark="op (from PATH)"/>
                        <Button Grid.Column="2" Content="Browse…" Click="OnBrowseOnePasswordCli"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Classes="label" Text="Default account"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OnePasswordAccount}" Watermark="e.g. my.1password.com"/>
                </Grid>
                <StackPanel Spacing="6" DataContext="{Binding OnePasswordTest}" x:DataType="vm:ProviderTestViewModel">
                    <Button Content="Test" Command="{Binding TestCommand}" IsEnabled="{Binding IsAvailable}"/>
                    <SelectableTextBlock Classes="status" Classes.failed="{Binding Failed}" Text="{Binding Status}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Vault / OpenBao -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="HashiCorp Vault / OpenBao" Classes="section-header"/>
                <TextBlock Classes="hint" Text="The mount, role / secret path and secret engine (KV, LDAP dynamic, LDAP static, SSH OTP) are set per connection."/>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                    <TextBlock Classes="label" Text="Server URL"/>
                    <TextBox Grid.Column="1" Text="{Binding VaultUrl}" Watermark="https://vault.domain.local:8200"/>
                    <TextBlock Grid.Row="2" Classes="label" Text="Namespace"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VaultNamespace}" Watermark="(none)"/>
                    <TextBlock Grid.Row="4" Classes="label" Text="Log in with"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding VaultAuthMethods}" SelectedItem="{Binding SelectedVaultAuthMethod}"/>
                    <TextBlock Grid.Row="6" Classes="label" Text="Auth mount path" IsVisible="{Binding VaultUsesLogin}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding VaultAuthMount}" Watermark="{Binding VaultAuthMountWatermark}"
                             IsVisible="{Binding VaultUsesLogin}"/>
                    <TextBlock Grid.Row="8" Classes="label" Text="{Binding VaultUsernameLabel}" IsVisible="{Binding VaultUsesLogin}"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding VaultUsername}" IsVisible="{Binding VaultUsesLogin}"/>
                    <TextBlock Grid.Row="10" Classes="label" Text="{Binding VaultSecretLabel}"/>
                    <Grid Grid.Row="10" Grid.Column="1" ColumnDefinitions="*,8,Auto" DataContext="{Binding VaultSecret}"
                          x:DataType="vm:ProviderSecretViewModel" IsEnabled="{Binding CanSave}">
                        <TextBox Text="{Binding Value}" PasswordChar="●" Watermark="{Binding State}"/>
                        <Button Grid.Column="2" Content="Forget" Command="{Binding ForgetCommand}"/>
                    </Grid>
                    <TextBlock Grid.Row="12" Classes="label" Text="CA certificate (PEM)"/>
                    <Grid Grid.Row="12" Grid.Column="1" ColumnDefinitions="*,8,Auto">
                        <TextBox Text="{Binding VaultCaCertificatePath}" Watermark="(system trust store)"/>
                        <Button Grid.Column="2" Content="Browse…" Click="OnBrowseVaultCa"/>
                    </Grid>
                </Grid>
                <StackPanel Spacing="6" DataContext="{Binding VaultTest}" x:DataType="vm:ProviderTestViewModel">
                    <Button Content="Test" Command="{Binding TestCommand}" IsEnabled="{Binding IsAvailable}"/>
                    <SelectableTextBlock Classes="status" Classes.failed="{Binding Failed}" Text="{Binding Status}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- AWS -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Amazon Web Services (EC2 address lookup)" Classes="section-header"/>
                <TextBlock Classes="hint" Text="Connections set the instance ID and region. The default credential chain reads environment variables, ~/.aws profiles, SSO and instance roles."/>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                    <TextBlock Classes="label" Text="Credentials"/>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AwsCredentialSources}" SelectedItem="{Binding SelectedAwsCredentialSource}"/>
                    <TextBlock Grid.Row="2" Classes="label" Text="Profile name" IsVisible="{Binding AwsUsesProfile}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AwsProfile}" IsVisible="{Binding AwsUsesProfile}" Watermark="e.g. default"/>
                    <TextBlock Grid.Row="4" Classes="label" Text="Access key ID" IsVisible="{Binding AwsUsesAccessKey}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AwsAccessKeyId}" IsVisible="{Binding AwsUsesAccessKey}"/>
                    <TextBlock Grid.Row="6" Classes="label" Text="Secret access key" IsVisible="{Binding AwsUsesAccessKey}"/>
                    <Panel Grid.Row="6" Grid.Column="1" IsVisible="{Binding AwsUsesAccessKey}">
                        <Grid ColumnDefinitions="*,8,Auto" DataContext="{Binding AwsSecretAccessKey}"
                              x:DataType="vm:ProviderSecretViewModel" IsEnabled="{Binding CanSave}">
                            <TextBox Text="{Binding Value}" PasswordChar="●" Watermark="{Binding State}"/>
                            <Button Grid.Column="2" Content="Forget" Command="{Binding ForgetCommand}"/>
                        </Grid>
                    </Panel>
                    <TextBlock Grid.Row="8" Classes="label" Text="Default region"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding AwsDefaultRegion}" Watermark="e.g. eu-central-1"/>
                    <TextBlock Grid.Row="10" Classes="label" Text="Connect to"/>
                    <ComboBox Grid.Row="10" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AwsAddressKinds}" SelectedItem="{Binding SelectedAwsAddressKind}"/>
                    <TextBlock Grid.Row="12" Classes="label" Text="EC2 endpoint URL"/>
                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding AwsServiceUrl}" Watermark="(regional AWS endpoint)"/>
                </Grid>
                <StackPanel Spacing="6" DataContext="{Binding AwsTest}" x:DataType="vm:ProviderTestViewModel">
                    <Button Content="Test" Command="{Binding TestCommand}" IsEnabled="{Binding IsAvailable}"/>
                    <SelectableTextBlock Classes="status" Classes.failed="{Binding Failed}" Text="{Binding Status}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
