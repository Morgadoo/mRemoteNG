<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.NotificationsSettingsPage"
             x:DataType="vm:NotificationsSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="Notifications" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="Desktop Notifications" Classes="section-header"/>
                <CheckBox IsChecked="{Binding ShowConnectNotify}" Content="Show a notification when a connection opens"/>
                <CheckBox IsChecked="{Binding ShowDisconnectNotify}" Content="Show a notification when a connection closes"/>
                <CheckBox IsChecked="{Binding ShowErrorNotify}" Content="Show a notification for errors written to the log"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
