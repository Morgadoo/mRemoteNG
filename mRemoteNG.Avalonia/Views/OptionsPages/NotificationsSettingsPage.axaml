<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.NotificationsSettingsPage"
             x:DataType="vm:NotificationsSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{l:Tr Notifications}" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{l:Tr DesktopNotifications}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding ShowConnectNotify}" Content="{l:Tr ShowANotificationWhenAConnectionOpens}"/>
                <CheckBox IsChecked="{Binding ShowDisconnectNotify}" Content="{l:Tr ShowANotificationWhenAConnectionCloses}"/>
                <CheckBox IsChecked="{Binding ShowErrorNotify}" Content="{l:Tr ShowANotificationForErrorsWrittenTo}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
