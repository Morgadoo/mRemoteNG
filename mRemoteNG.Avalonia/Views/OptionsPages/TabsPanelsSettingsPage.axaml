<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.OptionsPages.TabsPanelsSettingsPage"
             x:DataType="vm:TabsPanelsSettingsViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{l:Tr TabsAndPanels}" FontSize="18" FontWeight="Bold"/>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{l:Tr SessionTabs}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding ShowProtocolOnTabs}" Content="{l:Tr ShowProtocolOnTabs, English='Show protocol on tab names'}"/>
                <CheckBox IsChecked="{Binding ShowLogonInfoOnTabs}" Content="{l:Tr ShowLogonInfoOnTabs}"/>
                <CheckBox IsChecked="{Binding IdentifyQuickConnectTabs}" Content="{l:Tr IdentifyQuickConnectTabs}"/>
                <CheckBox IsChecked="{Binding DoubleClickOnTabClosesIt}" Content="{l:Tr DoubleClickTabClosesIt}"/>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{l:Tr Panels}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding AlwaysShowPanelTabs}" Content="{l:Tr AlwaysShowPanelTabs}"/>
                <CheckBox IsChecked="{Binding AlwaysShowPanelSelectionDlg}" Content="{l:Tr AlwaysShowPanelSelection}"/>
                <CheckBox IsChecked="{Binding CreateEmptyPanelOnStartUp}" Content="{l:Tr CreateEmptyPanelOnStartUp}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0"
                            IsEnabled="{Binding CreateEmptyPanelOnStartUp}">
                    <TextBlock Text="{l:Tr PanelName, Suffix=':', English='Panel name'}" VerticalAlignment="Center"/>
                    <TextBox Width="220" Text="{Binding StartUpPanelName}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{l:Tr _Sessions}" Classes="section-header"/>
                <CheckBox IsChecked="{Binding OpenConnectionsFromLastSession}"
                          Content="{l:Tr ReconnectAtStartup}"/>
                <CheckBox IsChecked="{Binding ReconnectOnDisconnect}"
                          Content="{l:Tr AutomaticallyTryToReconnectWhenDisconnectedFrom}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0"
                            IsEnabled="{Binding ReconnectOnDisconnect}">
                    <TextBlock Text="{l:Tr Attempts, Suffix=':'}" VerticalAlignment="Center"/>
                    <NumericUpDown Width="130" Value="{Binding ReconnectAttempts}"
                                   Minimum="{Binding MinReconnectAttempts}" Maximum="{Binding MaxReconnectAttempts}"
                                   Increment="1" FormatString="0"/>
                    <TextBlock Text="{l:Tr Waits124UpTo30}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
