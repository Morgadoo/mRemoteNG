<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:pages="using:mRemoteNG.Avalonia.Views.OptionsPages"
        x:Class="mRemoteNG.Avalonia.Views.OptionsWindow"
        x:DataType="vm:OptionsWindowViewModel"
        Title="{l:Tr Options}"
        Width="820"
        Height="580"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="*,Auto">

        <!-- Main content area: category list + page panel -->
        <Grid Grid.Row="0" ColumnDefinitions="200,Auto,*">

            <!-- Category list (left nav) -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Border0Brush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource AppBg1Brush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10">
                        <TextBlock Text="{l:Tr Options, Upper=True}" Classes="section-header"/>
                    </Border>
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                                <TextBlock Text="{Binding DisplayName}"
                                           Padding="12,6"
                                           FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3"/>

            <!-- Settings page (right panel) -->
            <ScrollViewer Grid.Column="2" Padding="20" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentPage}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
                            <pages:GeneralSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AppearanceSettingsViewModel}">
                            <pages:AppearanceSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectionSettingsViewModel}">
                            <pages:ConnectionSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CredentialsSettingsViewModel}">
                            <pages:CredentialsSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:NotificationsSettingsViewModel}">
                            <pages:NotificationsSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:UpdatesSettingsViewModel}">
                            <pages:UpdatesSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ExternalProvidersSettingsViewModel}">
                            <pages:ExternalProvidersSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:TabsPanelsSettingsViewModel}">
                            <pages:TabsPanelsSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SavingSettingsViewModel}">
                            <pages:SavingSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SqlServerSettingsViewModel}">
                            <pages:SqlServerSettingsPage/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:LoggingSettingsViewModel}">
                            <pages:LoggingSettingsPage/>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </ScrollViewer>

        </Grid>

        <!-- Bottom button bar -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource Border0Brush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ValidationMessage}"
                           IsVisible="{Binding HasValidationMessage}"
                           Foreground="#f44336"
                           TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">
                    <!-- Left: reset link (resets this dialog; OK/Apply makes it take effect) -->
                    <Button Grid.Column="0"
                            Content="{l:Tr ResetToDefaults}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}"
                            Command="{Binding ResetCommand}"/>
                    <!-- Right: action buttons -->
                    <Button Grid.Column="1" Content="{l:Tr _Ok}" Classes="accent" IsDefault="True"
                            MinWidth="80" Command="{Binding OkCommand}"/>
                    <Button Grid.Column="3" Content="{l:Tr _Cancel}" IsCancel="True"
                            MinWidth="80" Command="{Binding CancelCommand}"/>
                    <Button Grid.Column="5" Content="{l:Tr Apply}"
                            MinWidth="80" Command="{Binding ApplyCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
