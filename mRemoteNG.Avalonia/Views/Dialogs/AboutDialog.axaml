<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.AboutDialog"
        Title="{l:Tr AboutMRemoteNG}"
        Width="460"
        Height="340"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="32" Spacing="16">

        <!-- Logo + App Name -->
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
            <Image Width="64" Height="64"
                   Source="avares://mRemoteNG.Avalonia/Assets/Icons/mRemoteNG.ico"/>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="mRemoteNG"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextLinkBrush}"/>
                <TextBlock Text="Multi-Remote Next Generation"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Separator/>

        <!-- Version info -->
        <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock x:Name="VersionText"
                       Text="Version 1.78.2-dev"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock Text=".NET 10.0 · Avalonia UI 11"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{l:Tr CrossPlatformNotice}"
                       FontSize="11"
                       Foreground="{DynamicResource TextLinkBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Copyright -->
        <TextBlock Text="{l:Tr CopyrightNotice}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <Separator/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="{l:Tr GitHubRepository}" Padding="12,4"
                    x:Name="GitHubButton"/>
            <Button Content="{l:Tr Documentation}" Padding="12,4"
                    x:Name="DocsButton"/>
            <Button Content="{l:Tr _Ok}" Classes="accent" Padding="24,4"
                    x:Name="OkButton"/>
        </StackPanel>

    </StackPanel>
</Window>
