<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="{Binding WindowTitle}"
        Width="720"
        Height="660"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{ReflectionBinding Converter={x:Static vm:EnumLabelConverter.Instance}}"/>
        </DataTemplate>

        <!-- One property row: label, editor (picked by field type below), Inherit box -->
        <DataTemplate x:Key="FieldRowTemplate" x:DataType="vm:PropertyFieldViewModel">
            <Grid Classes="field-row" ColumnDefinitions="200,*,84" IsVisible="{Binding IsVisible}"
                  Background="Transparent" ToolTip.Tip="{Binding Description}">
                <TextBlock Classes="label" Text="{Binding DisplayName}"/>
                <StackPanel Grid.Column="1">
                    <ContentControl Content="{Binding}" IsEnabled="{Binding IsEditable}"/>
                    <TextBlock Classes="error" Text="{Binding Error}"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Classes="inherit" Content="{l:Tr Inherit}"
                          IsVisible="{Binding SupportsInheritance}"
                          IsEnabled="{Binding CanInherit}"
                          IsChecked="{Binding Inherit}"
                          ToolTip.Tip="{Binding InheritTip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:PropertySectionViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,12" IsVisible="{Binding IsVisible}">
                <TextBlock Classes="section-header" Text="{Binding Header}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRowTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="InheritanceSectionTemplate" x:DataType="vm:PropertySectionViewModel">
            <StackPanel Spacing="2" Margin="0,0,0,10">
                <TextBlock Classes="section-header" Text="{Binding Header}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PropertyFieldViewModel">
                            <CheckBox Width="220" Content="{Binding DisplayName}" IsChecked="{Binding Inherit}"
                                      IsEnabled="{Binding CanInherit}" ToolTip.Tip="{Binding Description}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Editors by field type; the more specific types come first. -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:ColorFieldViewModel">
            <Grid ColumnDefinitions="*,Auto">
                <AutoCompleteBox Classes="suggest" Text="{Binding Value, Mode=TwoWay}" ItemsSource="{Binding Suggestions}"
                                 FilterMode="ContainsOrdinal" MinimumPrefixLength="0" Watermark="{l:Tr DefaultInParentheses}"/>
                <Border Grid.Column="1" Width="22" Height="22" Margin="6,0,0,0" CornerRadius="3"
                        BorderBrush="{DynamicResource Border0Brush}" BorderThickness="1"
                        Background="{Binding Swatch}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:SuggestFieldViewModel">
            <AutoCompleteBox Classes="suggest" Text="{Binding Value, Mode=TwoWay}" ItemsSource="{Binding Suggestions}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"/>
        </DataTemplate>
        <DataTemplate DataType="vm:TextFieldViewModel">
            <TextBox Text="{Binding Value}" PasswordChar="{Binding PasswordChar}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:BoolFieldViewModel">
            <CheckBox IsChecked="{Binding Value}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:NumberFieldViewModel">
            <NumericUpDown Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                           FormatString="0" Increment="1" HorizontalAlignment="Left" MinWidth="160"/>
        </DataTemplate>
        <DataTemplate DataType="vm:ChoiceFieldViewModel">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" HorizontalAlignment="Stretch"
                      ItemTemplate="{StaticResource EnumItemTemplate}"/>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="Grid.field-row">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="Grid.field-row > TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Grid.field-row > CheckBox.inherit">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#E05252"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Classes="note" Margin="16,10,16,0" Text="{Binding InheritHint}"/>

        <TabControl Grid.Row="1" x:Name="Tabs" Margin="12,4,12,0">

            <TabItem Header="{l:Tr Display}" IsVisible="{Binding DisplayTab.IsVisible}">
                <ScrollViewer Padding="4,8,24,8">
                    <ItemsControl ItemsSource="{Binding DisplayTab.Sections}" ItemTemplate="{StaticResource SectionTemplate}"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Tr Connection}" IsVisible="{Binding ConnectionTab.IsVisible}">
                <ScrollViewer Padding="4,8,24,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ConnectionTab.Sections}" ItemTemplate="{StaticResource SectionTemplate}"/>
                        <TextBlock Classes="note" Text="{Binding ProtocolNote}" Margin="0,0,0,12"
                                   IsVisible="{Binding ProtocolNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- Host status (legacy config window "Status") -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsConnection}">
                            <TextBlock Classes="section-header" Text="{l:Tr Status}"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="CheckStatusButton" Content="{l:Tr CheckHostStatus}" Command="{Binding CheckStatusCommand}"
                                        ToolTip.Tip="{l:Tr PingTheHostAndTryToConnect}"/>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Tr Credentials}" IsVisible="{Binding CredentialsTab.IsVisible}">
                <ScrollViewer Padding="4,8,24,8">
                    <StackPanel>
                        <TextBlock Classes="note" IsVisible="{Binding IsFolder}" Margin="0,0,0,8"
                                   Text="{l:Tr ConnectionsInThisFolderCanInheritThese}"/>
                        <ItemsControl ItemsSource="{Binding CredentialsTab.Sections}" ItemTemplate="{StaticResource SectionTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Tr Protocol}" IsVisible="{Binding ProtocolTab.IsVisible}">
                <ScrollViewer Padding="4,8,24,8">
                    <ItemsControl ItemsSource="{Binding ProtocolTab.Sections}" ItemTemplate="{StaticResource SectionTemplate}"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Tr Miscellaneous}" IsVisible="{Binding MiscellaneousTab.IsVisible}">
                <ScrollViewer Padding="4,8,24,8">
                    <ItemsControl ItemsSource="{Binding MiscellaneousTab.Sections}" ItemTemplate="{StaticResource SectionTemplate}"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Tr Inheritance}" IsVisible="{Binding !IsRoot}">
                <ScrollViewer Padding="4,8,24,8">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="note" TextWrapping="Wrap"
                                   Text="{l:Tr CheckedPropertiesTakeTheirValueFromThe}"/>
                        <CheckBox x:Name="InheritEverythingBox" Content="{l:Tr InheritEverything}" FontWeight="SemiBold"
                                  IsThreeState="False" IsEnabled="{Binding CanInherit}"
                                  IsChecked="{Binding InheritEverything}"/>
                        <ItemsControl ItemsSource="{Binding InheritanceSections}"
                                      ItemTemplate="{StaticResource InheritanceSectionTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="16,10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{l:Tr _Cancel}" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button Content="{l:Tr _Ok}" Classes="accent" MinWidth="80" IsDefault="True" Command="{Binding OkCommand}"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
