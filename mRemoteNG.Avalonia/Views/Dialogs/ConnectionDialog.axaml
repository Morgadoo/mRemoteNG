<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="{Binding WindowTitle}"
        Width="560"
        Height="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" Padding="20">
            <StackPanel Spacing="14">

                <!-- General -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="General" Classes="section-header"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,12,Auto,12,Auto">
                            <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                            <TextBlock Grid.Row="2" Text="Hostname / IP" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Hostname}"/>
                            <TextBlock Grid.Row="4" Text="Description" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Description}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Protocol -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Protocol" Classes="section-header"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,12,Auto">
                            <TextBlock Grid.Row="0" Text="Protocol" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Protocols}"
                                      SelectedItem="{Binding SelectedProtocol}"/>
                            <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Value="{Binding Port}"
                                           Minimum="1" Maximum="65535"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Credentials -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Credentials" Classes="section-header"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,12,Auto,12,Auto">
                            <TextBlock Grid.Row="0" Text="Username" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username}"/>
                            <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Password}"
                                     PasswordChar="●"/>
                            <TextBlock Grid.Row="4" Text="Domain" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Domain}"
                                     Watermark="(Windows domain, optional)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RDP-specific (conditionally visible) -->
                <Border Classes="card" IsVisible="{Binding IsRdp}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="RDP Settings" Classes="section-header"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,12,Auto">
                            <TextBlock Grid.Row="0" Text="Color Depth" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding RdpColorDepths}"
                                      SelectedItem="{Binding RdpColorDepth}"/>
                            <TextBlock Grid.Row="2" Text="Smart Sizing" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding RdpSmartSize}"
                                      Content="Scale to fit window"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SSH-specific -->
                <Border Classes="card" IsVisible="{Binding IsSsh}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SSH Settings" Classes="section-header"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,12,Auto">
                            <TextBlock Grid.Row="0" Text="Private Key" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding SshKeyPath}"
                                     Watermark="Path to private key file"/>
                            <TextBlock Grid.Row="2" Text="Compression" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding SshCompression}"
                                      Content="Enable compression"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Button bar + test status -->
        <Border Grid.Row="1" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding TestStatus}"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,0,0,6"
                           IsVisible="{Binding TestStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="80" Command="{Binding CancelCommand}"/>
                    <Button Content="Test Connection" MinWidth="120" Command="{Binding TestCommand}"/>
                    <Button Content="Save" Classes="accent" MinWidth="80" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
