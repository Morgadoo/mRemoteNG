<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Classes="dialog"
        Title="{Binding WindowTitle}"
        Width="1040"
        Height="720"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{ReflectionBinding Converter={x:Static vm:EnumLabelConverter.Instance}}"/>
        </DataTemplate>

        <!-- One property: label + description, editor (picked by field type below), inherit toggle -->
        <DataTemplate x:Key="FieldRowTemplate" x:DataType="vm:PropertyFieldViewModel">
            <ctl:SettingRow Classes="field-row" Classes.first="{Binding IsFirstShown}" Classes.inherited="{Binding !IsEditable}"
                            Header="{Binding DisplayName}" Description="{Binding Description}"
                            IsVisible="{Binding IsShown}">
                <Grid ColumnDefinitions="320,8,28">
                    <StackPanel VerticalAlignment="Center">
                        <ContentControl Content="{Binding}" IsEnabled="{Binding IsEditable}"/>
                        <TextBlock Classes="field-error" Text="{Binding Error}" IsVisible="{Binding HasError}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Classes="inherit" VerticalAlignment="Top" Margin="0,2,0,0"
                                  IsVisible="{Binding SupportsInheritance}"
                                  IsEnabled="{Binding CanInherit}"
                                  IsChecked="{Binding Inherit}"
                                  ToolTip.Tip="{Binding InheritTip}">
                        <mi:MaterialIcon/>
                    </ToggleButton>
                </Grid>
            </ctl:SettingRow>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:PropertySectionViewModel">
            <StackPanel Classes="settings-group" Margin="0,0,0,24" IsVisible="{Binding IsVisible}">
                <TextBlock Classes="h2" Text="{Binding Header}" IsVisible="{Binding ShowHeader}"/>
                <Border Classes="settings">
                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRowTemplate}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="InheritanceSectionTemplate" x:DataType="vm:PropertySectionViewModel">
            <StackPanel Classes="settings-group" Margin="0,0,0,24" IsVisible="{Binding IsVisible}">
                <TextBlock Classes="h2" Text="{Binding Header}"/>
                <Border Classes="settings" Padding="16,8">
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PropertyFieldViewModel">
                                <CheckBox Width="236" Content="{Binding DisplayName}" IsChecked="{Binding Inherit}"
                                          IsVisible="{Binding MatchesSearch}"
                                          IsEnabled="{Binding CanInherit}" ToolTip.Tip="{Binding Description}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Editors by field type; the more specific types come first. -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:ColorFieldViewModel">
            <Grid ColumnDefinitions="*,8,Auto">
                <AutoCompleteBox Classes="suggest" Text="{Binding Value, Mode=TwoWay}" ItemsSource="{Binding Suggestions}"
                                 FilterMode="ContainsOrdinal" MinimumPrefixLength="0" Watermark="{l:Tr DefaultInParentheses}"/>
                <Border Grid.Column="2" Width="32" Height="32" CornerRadius="6"
                        BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                        Background="{Binding Swatch}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:SuggestFieldViewModel">
            <AutoCompleteBox Classes="suggest" Text="{Binding Value, Mode=TwoWay}" ItemsSource="{Binding Suggestions}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"/>
        </DataTemplate>
        <DataTemplate DataType="vm:TextFieldViewModel">
            <TextBox Text="{Binding Value}" PasswordChar="{Binding PasswordChar}"
                     Classes.error="{Binding HasError}" Classes.mono="{Binding IsMonospace}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:BoolFieldViewModel">
            <CheckBox Classes="switch" HorizontalAlignment="Right" IsChecked="{Binding Value}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:NumberFieldViewModel">
            <NumericUpDown Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                           FormatString="0" Increment="1" Classes.error="{Binding HasError}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:ChoiceFieldViewModel">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" HorizontalAlignment="Stretch"
                      ItemTemplate="{StaticResource EnumItemTemplate}"/>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- Pages without applicable properties are hidden from the navigation -->
        <Style Selector="ListBox.nav ListBoxItem" x:DataType="vm:PropertyPageViewModel">
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
        </Style>
        <Style Selector="ctl|SettingRow.field-row.first">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Inherited: the label reads as secondary, the editor shows the folder's value disabled -->
        <Style Selector="ctl|SettingRow.field-row.inherited /template/ TextBlock#PART_Header">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="NumericUpDown.error">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="NumericUpDown.error /template/ ButtonSpinner">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: icon, name, protocol chip, host, folder -->
        <Border Grid.Row="0" Padding="24,18" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <Panel Width="44" Height="44" VerticalAlignment="Center">
                    <Border Classes="icon-tile" Width="44" Height="44" CornerRadius="10" IsVisible="{Binding !ShowsProtocol}">
                        <mi:MaterialIcon Kind="{Binding HeaderIcon}" Width="24" Height="24"/>
                    </Border>
                    <Border Classes="icon-tile" Width="44" Height="44" CornerRadius="10" IsVisible="{Binding ShowsProtocol}"
                            Background="{Binding HeaderTintBrush}">
                        <mi:MaterialIcon Kind="{Binding HeaderIcon}" Width="24" Height="24"
                                         Foreground="{Binding HeaderIconBrush}"/>
                    </Border>
                </Panel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="{Binding HeaderTitle}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ctl:ProtocolChip Protocol="{Binding SelectedProtocol}" IsVisible="{Binding ShowsProtocol}"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Classes="secondary" Classes.mono="{Binding IsConnection}" MaxWidth="460"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    IsVisible="{Binding LocationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="·" Classes="caption"/>
                            <mi:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LocationText}" Classes="caption" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="232,*">

            <!-- Navigation: search + pages -->
            <Border Classes="dialog-nav">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Classes="search" Margin="12,16,12,12"
                             Text="{Binding SearchText}" Watermark="{l:Tr SearchPropertiesWatermark}"/>
                    <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="20,0,16,0" TextWrapping="Wrap"
                               Text="{l:Tr NoPropertiesMatch}" IsVisible="{Binding HasNoMatches}"/>
                    <ListBox x:Name="PageList" Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PropertyPageViewModel">
                                <Grid ColumnDefinitions="Auto,10,*,Auto">
                                    <mi:MaterialIcon Classes="nav-icon" Kind="{Binding Icon}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="3" Classes="dot danger" Margin="8,0,0,0" IsVisible="{Binding HasErrors}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Page -->
            <Border Grid.Column="1" Background="{DynamicResource AppBg0Brush}">
                <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageContent" Classes="settings-page" Margin="32,24,32,32" MaxWidth="860">
                        <StackPanel Classes="page-title">
                            <TextBlock Classes="h1" Text="{Binding SelectedPage.Title, FallbackValue=''}"/>
                            <TextBlock Classes="caption" Text="{Binding SelectedPageDescription}" TextWrapping="Wrap"
                                       IsVisible="{Binding SelectedPageDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- Inheritance page -->
                        <Border Classes="settings" IsVisible="{Binding IsInheritancePageSelected}">
                            <ctl:SettingRow Header="{l:Tr InheritEverything}" Description="{Binding InheritHint}">
                                <CheckBox x:Name="InheritEverythingBox" Classes="switch" IsThreeState="False"
                                          IsEnabled="{Binding CanInherit}" IsChecked="{Binding InheritEverything}"/>
                            </ctl:SettingRow>
                        </Border>
                        <ItemsControl ItemsSource="{Binding InheritanceSections}" IsVisible="{Binding IsInheritancePageSelected}"
                                      ItemTemplate="{StaticResource InheritanceSectionTemplate}" Margin="0,0,0,-24">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Property pages -->
                        <ItemsControl ItemsSource="{Binding SelectedPage.Sections, FallbackValue={x:Null}}"
                                      IsVisible="{Binding !IsInheritancePageSelected}"
                                      ItemTemplate="{StaticResource SectionTemplate}" Margin="0,0,0,-24">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- General page: how the protocol behaves here, host status -->
                        <Border Classes="callout info" IsVisible="{Binding IsGeneralPageSelected}">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsGeneralPageSelected"/>
                                    <Binding Path="ProtocolNote" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                </MultiBinding>
                            </Border.IsVisible>
                            <Grid ColumnDefinitions="Auto,*">
                                <mi:MaterialIcon Classes="callout-icon" Kind="InformationOutline"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProtocolNote}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <StackPanel Classes="settings-group">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsGeneralPageSelected"/>
                                    <Binding Path="IsConnection"/>
                                    <Binding Path="!IsSearching"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <TextBlock Classes="h2" Text="{l:Tr Status}"/>
                            <Border Classes="settings">
                                <ctl:SettingRow Header="{l:Tr CheckHostStatus}" Description="{l:Tr PingTheHostAndTryToConnect}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Right">
                                        <Button x:Name="CheckStatusButton" HorizontalAlignment="Right" Command="{Binding CheckStatusCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <mi:MaterialIcon Kind="LanCheck"/>
                                                <TextBlock Text="{l:Tr CheckHostStatus}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding StatusText}" Classes="caption mono" TextWrapping="Wrap"
                                                   HorizontalAlignment="Right" MaxWidth="360"
                                                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </ctl:SettingRow>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer: validation summary or inheritance hint; Cancel / OK -->
        <Border Grid.Row="2" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsValid}">
                    <mi:MaterialIcon Kind="AlertCircleOutline" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Classes="danger" Text="{Binding ErrorSummary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsValid}"
                            Margin="0,0,16,0">
                    <mi:MaterialIcon Kind="LinkVariant" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Classes="caption" Text="{Binding InheritHint}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="dialog-actions">
                    <Button Content="{l:Tr _Cancel}" IsCancel="True" Command="{Binding CancelCommand}"/>
                    <Button Content="{l:Tr _Ok}" Classes="accent" IsDefault="True" Command="{Binding OkCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
