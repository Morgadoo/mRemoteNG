<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.ActiveDirectoryImportDialog"
        x:DataType="vm:ActiveDirectoryImportViewModel"
        Classes="dialog"
        Title="{l:Tr ImportAD}"
        Width="1120"
        Height="680"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:DirectoryNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <ctl:DialogHeader Icon="Domain" Title="{l:Tr ImportAD}" Subtitle="{l:Tr ComputersAreImportedAsRDPConnections}"/>

        <!-- Directory server -->
        <Border Classes="card" Grid.Row="1" Margin="24,20,24,16">
            <Grid ColumnDefinitions="2*,12,110,12,Auto,24,130,12,1.5*,12,*,12,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0" Classes="field-label" Text="{l:Tr Server}"/>
                <TextBlock Grid.Column="2" Classes="field-label" Text="{l:Tr Port}"/>
                <TextBlock Grid.Column="6" Classes="field-label" Text="{l:Tr Bind}"/>
                <TextBlock Grid.Column="8" Classes="field-label" Text="{l:Tr Username}"/>
                <TextBlock Grid.Column="10" Classes="field-label" Text="{l:Tr Password}"/>

                <TextBox Grid.Row="1" Grid.Column="0" x:Name="ServerBox" Classes="mono" Text="{Binding Server}"
                         Watermark="{l:Tr Dc1CorpExampleEmptyThisComputerS}"/>
                <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Port}" FormatString="0" Minimum="0" Maximum="65535"
                               ShowButtonSpinner="False" ToolTip.Tip="{l:Tr N0389Or636WithLDAPS}"/>
                <CheckBox Grid.Row="1" Grid.Column="4" Classes="switch" Content="LDAPS" IsChecked="{Binding UseSsl}"/>
                <ComboBox Grid.Row="1" Grid.Column="6" x:Name="BindModeBox" ItemsSource="{Binding BindModes}" SelectedItem="{Binding BindMode}"
                          HorizontalAlignment="Stretch"/>
                <TextBox Grid.Row="1" Grid.Column="8" x:Name="UserBox" Text="{Binding Username}" Watermark="{l:Tr UserCNUserDomainOrDOMAINUser}"/>
                <TextBox Grid.Row="1" Grid.Column="10" x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•"/>
                <Button Grid.Row="1" Grid.Column="12" x:Name="ConnectButton" Command="{Binding ConnectCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="LanConnect"/>
                        <TextBlock Text="{l:Tr Connect}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- OU tree and computers -->
        <Grid Grid.Row="2" ColumnDefinitions="280,16,*" Margin="24,0,24,12">
            <Border Classes="card" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="panel-header" Background="Transparent"
                            BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{l:Tr OrganizationalUnits, Upper=True}" Classes="overline" VerticalAlignment="Center"/>
                    </Border>
                    <TreeView x:Name="OuTree" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:DirectoryNodeViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="FolderAccountOutline" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2" RowDefinitions="Auto,8,*">
                <Grid ColumnDefinitions="*,Auto,4,Auto">
                    <TextBlock Text="{l:Tr Computers}" Classes="h2" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="subtle" Content="{l:Tr All}" Command="{Binding SelectAllCommand}"/>
                    <Button Grid.Column="3" Classes="subtle" Content="{l:Tr None}" Command="{Binding SelectNoneCommand}"/>
                </Grid>
                <DataGrid Grid.Row="2" x:Name="ComputersGrid" ItemsSource="{Binding Computers}" AutoGenerateColumns="False"
                          CanUserResizeColumns="True" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="44"/>
                        <DataGridTextColumn Header="{l:Tr Name}" Binding="{Binding Name}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{l:Tr HostName}" Binding="{Binding HostName}" Width="1.4*" MinWidth="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="OU" Binding="{Binding Location}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{l:Tr OperatingSystem}" Binding="{Binding OperatingSystem}" Width="170" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{l:Tr Description}" Binding="{Binding Description}" Width="*" MinWidth="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="24" Margin="24,0,24,16">
            <CheckBox Classes="switch" Content="{l:Tr ImportSubOUs, English='Include sub-OUs'}" IsChecked="{Binding IncludeSubOus}"/>
            <CheckBox Classes="switch" Content="{l:Tr CreateFoldersForSubOUs}" IsChecked="{Binding CreateOuFolders}" IsEnabled="{Binding IncludeSubOus}"/>
        </StackPanel>

        <Border Grid.Row="4" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Classes="dialog-actions">
                    <Button Content="{l:Tr _Cancel}" x:Name="CancelButton" IsCancel="True"/>
                    <Button Content="{l:Tr _Import}" Classes="accent" x:Name="ImportButton"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
