<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.ActiveDirectoryImportDialog"
        x:DataType="vm:ActiveDirectoryImportViewModel"
        Title="Import from Active Directory"
        Width="1120"
        Height="620"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- The app theme does not include the DataGrid template; load it for this window. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <Style Selector="TreeViewItem" x:DataType="vm:DirectoryNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <!-- Directory server -->
        <Border Classes="card" Grid.Row="0" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,8,*,12,Auto,8,130,12,Auto" RowDefinitions="Auto,10,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="2" x:Name="ServerBox" Text="{Binding Server}"
                         Watermark="dc1.corp.example (empty: this computer's domain on Windows)"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Port" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="0" Grid.Column="6" Value="{Binding Port}" FormatString="0" Minimum="0" Maximum="65535"
                               ToolTip.Tip="0 = 389, or 636 with LDAPS"/>
                <CheckBox Grid.Row="0" Grid.Column="8" Content="LDAPS" IsChecked="{Binding UseSsl}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bind" VerticalAlignment="Center"/>
                <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="7" ColumnDefinitions="130,12,*,12,180,12,Auto">
                    <ComboBox x:Name="BindModeBox" ItemsSource="{Binding BindModes}" SelectedItem="{Binding BindMode}" HorizontalAlignment="Stretch"/>
                    <TextBox Grid.Column="2" x:Name="UserBox" Text="{Binding Username}" Watermark="user (CN=…, user@domain or DOMAIN\user)"/>
                    <TextBox Grid.Column="4" x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" Watermark="password"/>
                    <Button Grid.Column="6" Content="Connect" Classes="accent" MinWidth="90" x:Name="ConnectButton"
                            Command="{Binding ConnectCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- OU tree and computers -->
        <Grid Grid.Row="1" ColumnDefinitions="280,12,*" Margin="0,0,0,12">
            <Border Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Organizational units" Classes="section-header" Margin="0,0,0,8"/>
                    <TreeView x:Name="OuTree" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:DirectoryNodeViewModel">
                                <TextBlock Text="{Binding Name}"/>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,8,Auto" Margin="0,0,0,8">
                        <TextBlock Text="Computers" Classes="section-header" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="All" Command="{Binding SelectAllCommand}" Padding="10,2"/>
                        <Button Grid.Column="3" Content="None" Command="{Binding SelectNoneCommand}" Padding="10,2"/>
                    </Grid>
                    <DataGrid x:Name="ComputersGrid" ItemsSource="{Binding Computers}" AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal" CanUserResizeColumns="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="40"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="1.4*" MinWidth="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="OU" Binding="{Binding Location}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Operating system" Binding="{Binding OperatingSystem}" Width="170" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20" Margin="0,0,0,8">
            <CheckBox Content="Include sub-OUs" IsChecked="{Binding IncludeSubOus}"/>
            <CheckBox Content="Create folders for sub-OUs" IsChecked="{Binding CreateOuFolders}" IsEnabled="{Binding IncludeSubOus}"/>
            <TextBlock Text="Computers are imported as RDP connections." VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" MinWidth="80" x:Name="CancelButton" IsCancel="True"/>
                <Button Content="Import" Classes="accent" MinWidth="80" x:Name="ImportButton"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
