<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:svc="using:mRemoteNG.Avalonia.Services"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.ThemeEditorDialog"
        x:DataType="vm:ThemeEditorViewModel"
        Title="Theme Editor"
        Width="620" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="140,*">
                <TextBlock Text="Start from" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" x:Name="BaseCombo"
                          ItemsSource="{Binding AllThemes}" SelectedItem="{Binding BaseTheme}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:ThemeDefinition">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="140,*">
                <TextBlock Text="Save as" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="NameBox" Text="{Binding Name}" Watermark="Name of your theme"/>
            </Grid>
            <TextBlock Text="Colours change everywhere as you type (#rrggbb)." Opacity="0.7"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12">
            <ItemsControl ItemsSource="{Binding Colors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeColorEntry">
                        <Grid ColumnDefinitions="28,8,*,8,120" Margin="0,3">
                            <Border Width="24" Height="24" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{DynamicResource Border0Brush}" Background="{Binding Swatch}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <TextBox Grid.Column="4" Text="{Binding Value}" FontFamily="monospace"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
                <Button Content="Delete theme" Classes="danger" Command="{Binding DeleteCommand}"/>
                <Button Grid.Column="2" Content="Save and apply" Classes="accent" Click="OnSave"/>
                <Button Grid.Column="4" Content="Close" IsCancel="True" Click="OnClose"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
