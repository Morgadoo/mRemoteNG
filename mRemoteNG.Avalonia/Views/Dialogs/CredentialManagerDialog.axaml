<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.CredentialManagerDialog"
        x:DataType="vm:CredentialManagerViewModel"
        Classes="dialog"
        Title="{l:Tr CredentialManager}"
        Width="780"
        Height="560"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <ctl:DialogHeader Icon="KeyChainVariant" Title="{l:Tr CredentialManager}"
                          Subtitle="{l:Tr CredentialManagerSubtitle}"/>

        <Grid Grid.Row="1" ColumnDefinitions="260,16,*" Margin="24,20,24,24">

            <!-- Credential list -->
            <Border Classes="card" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="panel-header" Background="Transparent"
                            BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{l:Tr Credentials, Upper=True}" Classes="overline" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="icon" Command="{Binding AddCommand}" ToolTip.Tip="{l:Tr Add}">
                                <mi:MaterialIcon Kind="Plus"/>
                            </Button>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:Tr Remove}">
                                <mi:MaterialIcon Kind="TrashCanOutline"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ListBox ItemsSource="{Binding Credentials}" SelectedItem="{Binding Selected}"
                             BorderThickness="0" CornerRadius="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CredentialEntryViewModel">
                                <Grid ColumnDefinitions="Auto,10,*" Margin="0,6">
                                    <Border Classes="icon-tile neutral" Width="28" Height="28" CornerRadius="14">
                                        <mi:MaterialIcon Kind="AccountOutline" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Username}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Classes="card" Padding="20">
                <Panel>
                    <StackPanel Spacing="16" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{l:Tr CredentialDetails}" Classes="h2"/>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{l:Tr Name}"/>
                            <TextBox x:Name="NameBox" Text="{Binding Selected.Name, FallbackValue=''}" Watermark="{l:Tr CredentialLabel}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{l:Tr Username}"/>
                                <TextBox Text="{Binding Selected.Username, FallbackValue=''}" Watermark="user@domain"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="{l:Tr Domain}"/>
                                <TextBox Text="{Binding Selected.Domain, FallbackValue=''}" Watermark="{l:Tr WindowsDomainOptional}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{l:Tr Password}"/>
                            <TextBox Text="{Binding Selected.Password, FallbackValue=''}"
                                     PasswordChar="●"
                                     RevealPassword="{Binding #RevealPasswordBox.IsChecked}"
                                     Watermark="{l:Tr Password}"/>
                            <CheckBox x:Name="RevealPasswordBox" Classes="switch" Margin="0,10,0,0" Content="{l:Tr ShowPassword}"/>
                        </StackPanel>
                        <Border Classes="callout warning" IsVisible="{Binding Selected.PasswordUnavailable, FallbackValue=False}">
                            <Grid ColumnDefinitions="Auto,*">
                                <mi:MaterialIcon Classes="callout-icon" Kind="AlertOutline"/>
                                <TextBlock Grid.Column="1" Text="{l:Tr TheStoredPasswordCouldNotBeDecrypted}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}">
                        <mi:MaterialIcon Kind="KeyChainVariant" Width="48" Height="48" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{l:Tr SelectACredentialOrAddANew}" Classes="secondary" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="280"/>
                        <Button HorizontalAlignment="Center" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Plus"/>
                                <TextBlock Text="{l:Tr Add}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasError}"
                            Margin="0,0,16,0">
                    <mi:MaterialIcon Kind="AlertCircleOutline" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Classes="danger" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="dialog-actions">
                    <Button Content="{l:Tr _Cancel}" IsCancel="True" Command="{Binding CancelCommand}"/>
                    <Button Content="{l:Tr Save}" Classes="accent" IsDefault="True" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
