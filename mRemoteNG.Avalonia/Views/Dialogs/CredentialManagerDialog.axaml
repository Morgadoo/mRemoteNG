<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.CredentialManagerDialog"
        x:DataType="vm:CredentialManagerViewModel"
        Title="Credential Manager"
        Width="700"
        Height="500"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">

        <!-- Master-detail body -->
        <Grid Grid.Row="0" ColumnDefinitions="220,*" Margin="16,16,16,8">

            <!-- Left: credential list -->
            <Border Classes="card" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Credentials" Classes="section-header" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Credentials}"
                             SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CredentialEntryViewModel">
                                <StackPanel Spacing="2" Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Username}" FontSize="11" Opacity="0.65"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: detail form -->
            <Border Classes="card" Margin="8,0,0,0" Grid.Column="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Credential Details" Classes="section-header"/>

                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,12,Auto,12,Auto,12,Auto"
                          IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Selected.Name}"
                                 Watermark="Credential label"/>

                        <TextBlock Grid.Row="2" Text="Username" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Selected.Username}"
                                 Watermark="user@domain"/>

                        <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding Selected.Password}"
                                 PasswordChar="●"
                                 Watermark="Password"/>

                        <TextBlock Grid.Row="6" Text="Domain" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding Selected.Domain}"
                                 Watermark="Windows domain (optional)"/>
                    </Grid>

                    <!-- Placeholder text when nothing selected -->
                    <TextBlock Text="Select a credential or add a new one."
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Button bar -->
        <Border Grid.Row="1" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: list manipulation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add"    MinWidth="72" Command="{Binding AddCommand}"/>
                    <Button Content="Remove" MinWidth="72" Command="{Binding RemoveCommand}"/>
                </StackPanel>
                <!-- Right: dialog actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" MinWidth="80"/>
                    <Button Content="Save" Classes="accent" MinWidth="80" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
