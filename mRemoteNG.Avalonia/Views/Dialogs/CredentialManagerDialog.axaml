<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.CredentialManagerDialog"
        x:DataType="vm:CredentialManagerViewModel"
        Title="{l:Tr CredentialManager}"
        Width="700"
        Height="500"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">

        <!-- Master-detail body -->
        <Grid Grid.Row="0" ColumnDefinitions="220,*" Margin="16,16,16,8">

            <!-- Left: credential list -->
            <Border Classes="card" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr Credentials}" Classes="section-header" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Credentials}"
                             SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CredentialEntryViewModel">
                                <StackPanel Spacing="2" Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Username}" FontSize="11" Opacity="0.65"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: detail form -->
            <Border Classes="card" Margin="8,0,0,0" Grid.Column="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="{l:Tr CredentialDetails}" Classes="section-header"/>

                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,12,Auto,12,Auto,12,Auto,8,Auto"
                          IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <TextBlock Grid.Row="0" Text="{l:Tr Name}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Selected.Name}"
                                 Watermark="{l:Tr CredentialLabel}"/>

                        <TextBlock Grid.Row="2" Text="{l:Tr Username}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Selected.Username}"
                                 Watermark="user@domain"/>

                        <TextBlock Grid.Row="4" Text="{l:Tr Password}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding Selected.Password}"
                                 PasswordChar="●"
                                 RevealPassword="{Binding #RevealPasswordBox.IsChecked}"
                                 Watermark="{l:Tr Password}"/>

                        <TextBlock Grid.Row="6" Text="{l:Tr Domain}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="RevealPasswordBox" Content="{l:Tr ShowPassword}"/>
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding Selected.Domain}"
                                 Watermark="{l:Tr WindowsDomainOptional}"/>
                    </Grid>

                    <TextBlock Text="{l:Tr TheStoredPasswordCouldNotBeDecrypted}"
                               TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                               IsVisible="{Binding Selected.PasswordUnavailable, FallbackValue=False}"/>

                    <!-- Placeholder text when nothing selected -->
                    <TextBlock Text="{l:Tr SelectACredentialOrAddANew}"
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Button bar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: list manipulation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr Add}"    MinWidth="72" Command="{Binding AddCommand}"/>
                    <Button Content="{l:Tr Remove}" MinWidth="72" Command="{Binding RemoveCommand}"/>
                </StackPanel>
                <!-- Right: dialog actions -->
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                           Foreground="#f44336" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr _Cancel}" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}"/>
                    <Button Content="{l:Tr Save}" Classes="accent" MinWidth="80" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
