<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.PortScannerDialog"
        x:DataType="vm:PortScannerViewModel"
        Title="Port Scanner"
        Width="750"
        Height="550"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <!-- Target card -->
        <Border Classes="card" Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Spacing="12">
                <TextBlock Text="Target" Classes="section-header"/>
                <Grid ColumnDefinitions="80,*,16,80,100,16,80,100,16,80,120"
                      RowDefinitions="Auto">

                    <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center"/>
                    <TextBox   Grid.Column="1" Text="{Binding TargetHost}" Watermark="hostname or IP"/>

                    <TextBlock Grid.Column="3" Text="Port From" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="4"
                                   Value="{Binding PortFrom}"
                                   Minimum="1" Maximum="65535" Increment="1"/>

                    <TextBlock Grid.Column="6" Text="Port To" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="7"
                                   Value="{Binding PortTo}"
                                   Minimum="1" Maximum="65535" Increment="1"/>

                    <TextBlock Grid.Column="9" Text="Timeout ms" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="10"
                                   Value="{Binding TimeoutMs}"
                                   Minimum="50" Maximum="30000" Increment="100"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Stop"
                            MinWidth="80"
                            Command="{Binding StopCommand}"/>
                    <Button Content="Start Scan"
                            Classes="accent"
                            MinWidth="100"
                            Command="{Binding StartCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results DataGrid -->
        <Border Classes="card" Grid.Row="1" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Results" Classes="section-header" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Port"    Binding="{Binding Port}"      Width="70"/>
                        <DataGridTextColumn Header="Status"  Binding="{Binding Status}"     Width="90"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding Service}"    Width="120"/>
                        <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="2"
                     Minimum="0" Maximum="100"
                     Value="{Binding ScanProgress}"
                     Height="8"
                     Margin="0,0,0,8"/>

        <!-- Status bar -->
        <Border Grid.Row="3" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" Opacity="0.75" FontSize="12"/>
        </Border>

    </Grid>
</Window>
