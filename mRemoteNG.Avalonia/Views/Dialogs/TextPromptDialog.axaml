<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.TextPromptDialog"
        Title="{l:Tr InputRequired}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{l:Tr _Cancel}" MinWidth="80" x:Name="CancelButton" IsCancel="True"/>
            <Button Content="{l:Tr _Ok}" Classes="accent" MinWidth="80" x:Name="OkButton" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
