<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.SshFileTransferDialog"
        x:DataType="vm:SshFileTransferViewModel"
        Title="{l:Tr SshFileTransfer, English='SSH File Transfer (SFTP)'}"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">

        <!-- Connection -->
        <Grid Grid.Row="0" ColumnDefinitions="2*,8,70,8,*,8,*,8,*,8,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Text="{Binding Host}" Watermark="{l:Tr Host}"
                     IsEnabled="{Binding !IsConnected}"/>
            <NumericUpDown Grid.Column="2" Value="{Binding Port}" Minimum="1" Maximum="65535"
                           FormatString="0" ShowButtonSpinner="False" ToolTip.Tip="{l:Tr Port}"
                           IsEnabled="{Binding !IsConnected}"/>
            <TextBox Grid.Column="4" Text="{Binding Username}" Watermark="{l:Tr Username}"
                     IsEnabled="{Binding !IsConnected}"/>
            <TextBox Grid.Column="6" Text="{Binding Password}" Watermark="{l:Tr Password}" PasswordChar="●"
                     IsEnabled="{Binding !IsConnected}"/>
            <TextBox Grid.Column="8" Text="{Binding PrivateKeyPath}" Watermark="{l:Tr PrivateKeyOptional}"
                     IsEnabled="{Binding !IsConnected}"/>
            <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="8">
                <Button Content="{l:Tr Connect}" Classes="accent" MinWidth="90" Command="{Binding ConnectCommand}"
                        IsVisible="{Binding !IsConnected}" IsDefault="True"/>
                <Button Content="{l:Tr Disconnect}" MinWidth="90" Command="{Binding DisconnectCommand}"
                        IsVisible="{Binding IsConnected}"/>
            </StackPanel>
        </Grid>

        <!-- Remote path and actions -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,8,*,8,Auto" Margin="0,0,0,6">
            <Button Grid.Column="0" Content="↑" MinWidth="32" ToolTip.Tip="{l:Tr ParentFolder}"
                    Command="{Binding UpCommand}"/>
            <TextBox Grid.Column="2" x:Name="RemotePathBox" Text="{Binding RemotePath}"
                     Watermark="{l:Tr RemotePathPressEnterToOpen}" IsEnabled="{Binding IsConnected}"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                <Button Content="{l:Tr Refresh}" Command="{Binding RefreshCommand}"/>
                <Button Content="{l:Tr NewFolder, Suffix='…', English='New folder'}" Command="{Binding NewFolderCommand}"/>
                <Button Content="{l:Tr _Delete, Suffix='…'}" Command="{Binding DeleteCommand}"/>
                <Button Content="{l:Tr Upload, Suffix='…'}" Classes="accent" Command="{Binding UploadCommand}"/>
                <Button Content="{l:Tr Download, Suffix='…'}" Classes="accent" Command="{Binding DownloadCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Remote file list -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="1" Margin="0,0,0,8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,100,150" Margin="12,6">
                    <TextBlock Grid.Column="0" Text="{l:Tr Name}" Opacity="0.65" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{l:Tr Size}" Opacity="0.65" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{l:Tr Modified}" Opacity="0.65" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
                <ListBox x:Name="RemoteList"
                         ItemsSource="{Binding RemoteFiles}"
                         SelectedItem="{Binding SelectedRemote}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SftpFileItem">
                            <Grid ColumnDefinitions="*,100,150">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" HorizontalAlignment="Right"
                                           Opacity="0.65" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="{Binding Modified}" HorizontalAlignment="Right"
                                           Opacity="0.65" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Progress -->
        <Grid Grid.Row="3" ColumnDefinitions="*,8,Auto" Margin="0,0,0,8" IsVisible="{Binding IsTransferring}">
            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding TransferProgress}"
                         Height="8" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="{l:Tr _Cancel}" Command="{Binding CancelCommand}"/>
        </Grid>

        <!-- Status + Close -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Grid.Column="0"
                                     Text="{Binding Status}"
                                     Classes.error="{Binding HasError}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center"
                                     FontSize="12">
                    <SelectableTextBlock.Styles>
                        <Style Selector="SelectableTextBlock.error">
                            <Setter Property="Foreground" Value="#E05252"/>
                        </Style>
                    </SelectableTextBlock.Styles>
                </SelectableTextBlock>
                <Button Grid.Column="1" x:Name="CloseButton" Content="{l:Tr _Close}" MinWidth="80" IsCancel="True"/>
            </Grid>
        </Border>

    </Grid>
</Window>
