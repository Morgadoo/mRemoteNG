<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.HostKeyDialog"
        Title="SSH Host Key"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="12">

        <!-- Shown for a changed key -->
        <Border x:Name="WarningBanner" Background="#B3261E" CornerRadius="4" Padding="12" IsVisible="False">
            <StackPanel Spacing="6">
                <TextBlock Text="WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!"
                           FontWeight="Bold" FontSize="15" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock Foreground="White" TextWrapping="Wrap"
                           Text="Someone could be eavesdropping on you right now (man-in-the-middle attack). It is also possible that the host key has just been changed by an administrator. Do not continue unless you have verified the new fingerprint with the server's administrator."/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Opacity="0.85"/>

        <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,6,Auto,6,Auto">
            <TextBlock Grid.Row="0" Text="Host" VerticalAlignment="Center" Opacity="0.75"/>
            <SelectableTextBlock Grid.Row="0" Grid.Column="2" x:Name="HostText" FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace"/>
            <TextBlock Grid.Row="2" Text="Key type" VerticalAlignment="Center" Opacity="0.75"/>
            <SelectableTextBlock Grid.Row="2" Grid.Column="2" x:Name="KeyTypeText" FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace"/>
            <TextBlock Grid.Row="4" Text="Fingerprint" VerticalAlignment="Center" Opacity="0.75"/>
            <SelectableTextBlock Grid.Row="4" Grid.Column="2" x:Name="FingerprintText" TextWrapping="Wrap"
                                 FontWeight="Bold" FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace"/>
        </Grid>

        <!-- Stored keys for a changed key, or other known key types -->
        <StackPanel x:Name="StoredPanel" Spacing="4" IsVisible="False">
            <TextBlock x:Name="StoredHeading" FontWeight="Bold" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="StoredText" TextWrapping="Wrap" FontSize="12"
                                 FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace"/>
        </StackPanel>

        <CheckBox x:Name="ConfirmReplaceBox" IsVisible="False"
                  Content="I have verified the new fingerprint and want to replace the stored key"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" IsCancel="True"/>
            <Button x:Name="OnceButton" Content="Connect once" MinWidth="110" IsVisible="False"/>
            <Button x:Name="AcceptButton" Content="Accept and save" Classes="accent" MinWidth="120" IsVisible="False"/>
            <Button x:Name="ReplaceButton" Content="Replace key and connect" MinWidth="160" IsVisible="False"
                    IsEnabled="False" Background="#B3261E" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
