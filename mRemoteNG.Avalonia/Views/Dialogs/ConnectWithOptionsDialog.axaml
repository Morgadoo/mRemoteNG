<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.ConnectWithOptionsDialog"
        x:DataType="vm:ConnectWithOptionsViewModel"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding ConnectionName, StringFormat='Connect to \&quot;{0}\&quot; with:'}" TextWrapping="Wrap"/>

        <CheckBox x:Name="NoCredentialsBox" Content="Connect without credentials" IsChecked="{Binding NoCredentials}"/>
        <CheckBox Content="Connect in full screen" IsChecked="{Binding Fullscreen}"/>
        <CheckBox Content="Connect in view-only mode" IsChecked="{Binding ViewOnly}" IsEnabled="{Binding SupportsViewOnly}"/>

        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,8,Auto">
            <TextBlock Text="Console session" VerticalAlignment="Center" IsVisible="{Binding IsRdp}"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsRdp}"
                      ItemsSource="{Binding ConsoleSessionChoices}" SelectedItem="{Binding ConsoleSession}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsoleSessionChoice">
                        <TextBlock Text="{Binding Converter={x:Static vm:EnumLabelConverter.Instance}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="Panel" VerticalAlignment="Center"/>
            <AutoCompleteBox Grid.Row="2" Grid.Column="1" x:Name="PanelBox" Text="{Binding Panel, Mode=TwoWay}"
                             ItemsSource="{Binding Panels}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                             Watermark="(the connection's panel)"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}"/>
            <Button Content="Connect" Classes="accent" MinWidth="80" IsDefault="True" Command="{Binding ConnectCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
