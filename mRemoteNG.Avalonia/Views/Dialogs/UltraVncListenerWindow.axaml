<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.UltraVncListenerWindow"
        x:DataType="vm:UltraVncListenerViewModel"
        Title="{l:Tr UltraVNCSingleClickListener}"
        Width="640"
        Height="420"
        MinWidth="440"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{l:Tr UltraVNCSingleClickListener}" FontSize="16" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{l:Tr RemoteUsersRunningUltraVNCSingleClickOrAny}"/>
        </StackPanel>

        <Border Classes="card" Grid.Row="1" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,8,120,*,Auto,8,Auto">
                <TextBlock Grid.Column="0" Text="{l:Tr Port}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="2" x:Name="PortBox"
                               Value="{Binding Port}" FormatString="0"
                               Minimum="1" Maximum="65535" Increment="1"
                               IsEnabled="{Binding !IsListening}"/>
                <Button Grid.Column="4" Content="{l:Tr _Stop}" MinWidth="80" x:Name="StopButton" Command="{Binding StopCommand}"/>
                <Button Grid.Column="6" Content="{l:Tr StartListening}" Classes="accent" MinWidth="120" x:Name="StartButton"
                        Command="{Binding StartCommand}"/>
            </Grid>
        </Border>

        <Border Classes="card" Grid.Row="2" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:Tr IncomingConnections}" Classes="section-header" Margin="0,0,0,8"/>
                <DataGrid x:Name="ConnectionsGrid" ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Tr Time}" Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                        <DataGridTextColumn Header="{l:Tr From}" Binding="{Binding Remote}" Width="160"/>
                        <DataGridTextColumn Header="{l:Tr Status}" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Opacity="0.75" FontSize="12" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
