<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.QuickConnectDialog"
        x:DataType="vm:QuickConnectViewModel"
        Title="{l:Tr QuickConnect}"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="{l:Tr QuickConnect}" FontSize="16" FontWeight="Bold"/>

        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,12,Auto,12,Auto,12,Auto" >
            <TextBlock Grid.Row="0" Text="{l:Tr HostnameLabel}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Hostname}"
                     Watermark="{l:Tr HostOrIPPort}"
                     x:Name="HostnameBox"/>

            <TextBlock Grid.Row="2" Text="{l:Tr Protocol}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding Protocols}"
                      SelectedItem="{Binding SelectedProtocol}"/>

            <TextBlock Grid.Row="4" Text="{l:Tr Username}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding Username}"
                     Watermark="{l:Tr OptionalInParentheses}"/>

            <TextBlock Grid.Row="6" Text="{l:Tr Password}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1"
                     Text="{Binding Password}"
                     PasswordChar="●"
                     Watermark="{l:Tr OptionalInParentheses}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{l:Tr _Cancel}" MinWidth="80" x:Name="CancelBtn" IsCancel="True"/>
            <Button Content="{l:Tr Connect}" Classes="accent" MinWidth="80" IsDefault="True"
                    Command="{Binding ConnectCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
