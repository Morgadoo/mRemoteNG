<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.PasswordPromptDialog"
        Title="Password Required"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="Password"/>
        <TextBlock x:Name="ErrorText" Foreground="#E05252" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="80" x:Name="CancelButton" IsCancel="True"/>
            <Button Content="OK" Classes="accent" MinWidth="80" x:Name="OkButton" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
