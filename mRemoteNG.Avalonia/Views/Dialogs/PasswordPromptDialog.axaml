<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
        x:Class="mRemoteNG.Avalonia.Views.Dialogs.PasswordPromptDialog"
        Classes="dialog"
        Title="{l:Tr PasswordRequired}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,Auto">
        <ctl:DialogHeader Icon="LockOutline" Title="{l:Tr PasswordRequired}"/>

        <StackPanel Grid.Row="1" Margin="24,16,24,24" Spacing="12">
            <TextBlock x:Name="MessageText" Classes="secondary" TextWrapping="Wrap"/>
            <StackPanel>
                <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="{l:Tr Password}"/>
                <TextBlock x:Name="ErrorText" Classes="field-error" IsVisible="False"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button x:Name="CancelButton" Content="{l:Tr _Cancel}" IsCancel="True"/>
                <Button x:Name="OkButton" Content="{l:Tr _Ok}" Classes="accent" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
