<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        x:Class="mRemoteNG.Avalonia.Views.Sessions.FloatingPanelWindow"
        Title="{l:Tr FloatingPanelTitle}"
        Width="900"
        Height="600"
        MinWidth="320"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg0Brush}"
        Icon="avares://mRemoteNG.Avalonia/Assets/Icons/mRemoteNG.ico">
    <Border x:Name="PanelHost"/>
</Window>
