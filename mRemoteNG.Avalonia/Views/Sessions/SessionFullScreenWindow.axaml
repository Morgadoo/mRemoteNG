<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:dock="using:mRemoteNG.Avalonia.ViewModels.Docking"
        xmlns:conv="using:mRemoteNG.Avalonia.Converters"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="mRemoteNG.Avalonia.Views.Sessions.SessionFullScreenWindow"
        x:DataType="dock:SessionTabViewModel"
        Title="{Binding DisplayTitle}"
        Background="{DynamicResource AppBg0Brush}"
        WindowState="FullScreen"
        Icon="avares://mRemoteNG.Avalonia/Assets/Icons/mRemoteNG.ico">

    <Window.Styles>
        <StyleInclude Source="avares://mRemoteNG.Avalonia/Views/Sessions/SessionStyles.axaml"/>
        <Style Selector="Border#ConnectionBar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <Border BorderBrush="{Binding FrameBrush}"
                BorderThickness="{Binding FrameThickness}"
                Padding="{Binding FramePadding}">
            <Border x:Name="ViewHost"/>
        </Border>

        <!-- Connection bar: faint until the pointer reaches it; Ctrl+Alt+Enter also leaves full screen -->
        <Border x:Name="ConnectionBar"
                Classes="elevated"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="0,0,10,10"
                BorderThickness="1,0,1,1"
                Padding="12,5,6,5"
                Opacity="0.25">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <mi:MaterialIcon VerticalAlignment="Center"
                                 Kind="{Binding Converter={x:Static conv:ConnectionConverters.Icon}}"
                                 Foreground="{Binding IconBrush}"/>
                <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" FontWeight="Medium"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <Border Classes="dot"
                        Classes.success="{Binding IsStatusConnected}"
                        Classes.warning="{Binding IsStatusBusy}"
                        Classes.danger="{Binding IsStatusError}"
                        IsVisible="{Binding HasStatusDot}"/>
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border Classes="keycap"><TextBlock Text="Ctrl"/></Border>
                    <Border Classes="keycap"><TextBlock Text="Alt"/></Border>
                    <Border Classes="keycap"><TextBlock Text="Enter"/></Border>
                </StackPanel>
                <Button x:Name="ExitButton" Classes="subtle" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="FullscreenExit"/>
                        <TextBlock Text="{l:Tr ExitFullScreen}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
