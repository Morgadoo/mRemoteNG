<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        x:Class="mRemoteNG.Avalonia.Views.Sessions.ChoosePanelDialog"
        Title="{l:Tr TitleSelectPanel}"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{l:Tr SelectThePanelToOpenTheConnection, Suffix=':'}" TextWrapping="Wrap"/>
        <ListBox x:Name="PanelList" MaxHeight="220" MinHeight="80"/>
        <TextBlock Text="{l:Tr OrOpenItInANewPanel, Suffix=':'}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="NewPanelBox" Watermark="{l:Tr NewPanelName}"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{l:Tr _Cancel}" MinWidth="80" x:Name="CancelButton" IsCancel="True"/>
            <Button Content="{l:Tr _Ok}" Classes="accent" MinWidth="80" x:Name="OkButton" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
