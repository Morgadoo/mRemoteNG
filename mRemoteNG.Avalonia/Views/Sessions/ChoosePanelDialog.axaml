<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mRemoteNG.Avalonia.Views.Sessions.ChoosePanelDialog"
        Title="Select Panel"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Select the panel to open the connection in:" TextWrapping="Wrap"/>
        <ListBox x:Name="PanelList" MaxHeight="220" MinHeight="80"/>
        <TextBlock Text="Or open it in a new panel:" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="NewPanelBox" Watermark="New panel name"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="80" x:Name="CancelButton" IsCancel="True"/>
            <Button Content="OK" Classes="accent" MinWidth="80" x:Name="OkButton" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
