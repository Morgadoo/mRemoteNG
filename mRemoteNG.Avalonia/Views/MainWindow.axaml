<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:dock="using:mRemoteNG.Avalonia.ViewModels.Docking"
        xmlns:views="using:mRemoteNG.Avalonia.Views"
        xmlns:sessions="using:mRemoteNG.Avalonia.Views.Sessions"
        x:Class="mRemoteNG.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="avares://mRemoteNG.Avalonia/Assets/Icons/mRemoteNG.ico">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewFileCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewConnectionCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenConnectionFileCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveConnectionFileCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsConnectionFileCommand}"/>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding OpenQuickConnectDialogCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ToggleConnectionTreeCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding ToggleLogPanelCommand}"/>
        <KeyBinding Gesture="F11" Command="{Binding ToggleFullScreenCommand}"/>
    </Window.KeyBindings>

    <DockPanel>

        <!-- MENU BAR -->
        <Menu DockPanel.Dock="Top" FontSize="13">
            <MenuItem Header="_File">
                <MenuItem Header="_New Connection File" Command="{Binding NewFileCommand}" InputGesture="Ctrl+Shift+N"/>
                <MenuItem Header="_Open Connection File..." Command="{Binding OpenConnectionFileCommand}" InputGesture="Ctrl+O"/>
                <MenuItem Header="_Save Connection File" Command="{Binding SaveConnectionFileCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save Connection File _As..." Command="{Binding SaveAsConnectionFileCommand}" InputGesture="Ctrl+Shift+S"/>
                <MenuItem Header="Open from SQL _Database" Command="{Binding OpenDatabaseCommand}"/>
                <MenuItem Header="_Reload from SQL Database" Command="{Binding ReloadDatabaseCommand}"/>
                <Separator/>
                <MenuItem Header="New _Connection..." Command="{Binding NewConnectionCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="New _Folder..." Command="{Binding ConnectionTree.NewFolderCommand}"/>
                <MenuItem Header="_Edit Selected..." Command="{Binding ConnectionTree.EditSelectedCommand}" InputGesture="Ctrl+E"/>
                <MenuItem Header="_Duplicate Selected" Command="{Binding ConnectionTree.DuplicateSelectedCommand}" InputGesture="Ctrl+D"/>
                <MenuItem Header="De_lete Selected..." Command="{Binding ConnectionTree.DeleteSelectedCommand}" InputGesture="Delete"/>
                <Separator/>
                <MenuItem Header="Default Connection Properties..." Command="{Binding ConnectionTree.EditDefaultConnectionCommand}"/>
                <MenuItem Header="Connection File _Properties..." Command="{Binding ConnectionTree.FilePropertiesCommand}"/>
                <Separator/>
                <MenuItem Header="_Import Connections..." Command="{Binding ImportCommand}"/>
                <MenuItem Header="_Export Connections..." Command="{Binding ExportCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="_View" x:Name="ViewMenu">
                <MenuItem Header="Connection Tree" ToggleType="CheckBox"
                          IsChecked="{Binding IsConnectionTreeVisible, Mode=OneWay}"
                          Command="{Binding ToggleConnectionTreeCommand}" InputGesture="Ctrl+Shift+T"/>
                <MenuItem Header="Log Panel" ToggleType="CheckBox"
                          IsChecked="{Binding IsLogPanelVisible, Mode=OneWay}"
                          Command="{Binding ToggleLogPanelCommand}" InputGesture="Ctrl+Shift+L"/>
                <MenuItem Header="Multi-SSH Toolbar" ToggleType="CheckBox"
                          IsChecked="{Binding IsMultiSshToolbarVisible, Mode=OneWay}"
                          Command="{Binding ToggleMultiSshToolbarCommand}"/>
                <Separator/>
                <MenuItem Header="Expand All Folders" Command="{Binding ConnectionTree.ExpandAllCommand}"/>
                <MenuItem Header="Collapse All Folders" Command="{Binding ConnectionTree.CollapseAllCommand}"/>
                <MenuItem Header="Refresh PuTTY Sessions" Command="{Binding ConnectionTree.RefreshPuttySessionsCommand}"/>
                <Separator/>
                <MenuItem Header="New Panel" Command="{Binding NewPanelCommand}"/>
                <MenuItem Header="Arrange Panels">
                    <MenuItem x:Name="ArrangeTabbedItem" Header="Tabbed (one panel at a time)" ToggleType="Radio"
                              Command="{Binding ArrangePanelsCommand}"
                              CommandParameter="{x:Static dock:PanelArrangement.Tabbed}"/>
                    <MenuItem x:Name="ArrangeSideBySideItem" Header="Side by Side" ToggleType="Radio"
                              Command="{Binding ArrangePanelsCommand}"
                              CommandParameter="{x:Static dock:PanelArrangement.SideBySide}"/>
                    <MenuItem x:Name="ArrangeStackedItem" Header="Stacked" ToggleType="Radio"
                              Command="{Binding ArrangePanelsCommand}"
                              CommandParameter="{x:Static dock:PanelArrangement.Stacked}"/>
                </MenuItem>
                <MenuItem Header="Reset Layout" Command="{Binding ResetLayoutCommand}"/>
                <Separator/>
                <MenuItem Header="Full Screen" ToggleType="CheckBox"
                          IsChecked="{Binding IsFullScreen, Mode=OneWay}"
                          Command="{Binding ToggleFullScreenCommand}" InputGesture="F11"/>
            </MenuItem>

            <MenuItem Header="_Sessions" x:Name="SessionsMenu">
                <MenuItem Header="Next Session" Command="{Binding NextSessionCommand}" InputGesture="Ctrl+Tab"/>
                <MenuItem Header="Previous Session" Command="{Binding PreviousSessionCommand}" InputGesture="Ctrl+Shift+Tab"/>
                <Separator/>
                <MenuItem Header="Reconnect All" Command="{Binding ReconnectAllCommand}"/>
                <MenuItem Header="Disconnect All" Command="{Binding DisconnectAllCommand}"/>
                <MenuItem Header="Close All Sessions" Command="{Binding CloseAllSessionsCommand}"/>
                <Separator/>
                <MenuItem Header="Connect Selected to Panel..." Command="{Binding ConnectSelectedToPanelCommand}"/>
                <MenuItem Header="New Panel" Command="{Binding NewPanelCommand}"/>
                <Separator x:Name="SessionListSeparator"/>
            </MenuItem>

            <MenuItem Header="F_avorites" x:Name="FavoritesMenu">
                <MenuItem Header="(No favorites)" IsEnabled="False"/>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="Quick Connect..." Command="{Binding OpenQuickConnectDialogCommand}" InputGesture="Ctrl+Q"/>
                <MenuItem Header="SFTP File Transfer..." Command="{Binding OpenSftpCommand}"/>
                <Separator/>
                <MenuItem Header="Port Scanner..." Command="{Binding PortScannerCommand}"/>
                <MenuItem Header="External Tools..." Command="{Binding ExternalToolsCommand}"/>
                <MenuItem Header="UltraVNC SingleClick Listener..." Command="{Binding UltraVncListenerCommand}"/>
                <Separator/>
                <MenuItem Header="_Options..." Command="{Binding OpenOptionsCommand}" InputGesture="Ctrl+,"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About mRemoteNG..." Command="{Binding AboutCommand}"/>
                <MenuItem Header="Check for Updates..." Command="{Binding CheckForUpdatesCommand}"
                          ToolTip.Tip="Opens the mRemoteNG releases page"/>
                <Separator/>
                <MenuItem Header="GitHub Repository" Command="{Binding OpenGitHubCommand}"/>
                <MenuItem Header="Documentation" Command="{Binding OpenDocumentationCommand}"/>
                <MenuItem Header="Report a Bug" Command="{Binding ReportBugCommand}"/>
                <MenuItem Header="Open Log File" Command="{Binding OpenLogFileCommand}"/>
            </MenuItem>
        </Menu>

        <!-- TOOLBAR -->
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                <Button ToolTip.Tip="New Connection (Ctrl+N)"
                        Command="{Binding NewConnectionCommand}"
                        Padding="8,3">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#4caf50"/>
                        <TextBlock Text="New" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button ToolTip.Tip="Open Connection File (Ctrl+O)"
                        Command="{Binding OpenConnectionFileCommand}"
                        Padding="8,3">
                    <TextBlock Text="Open" FontSize="12"/>
                </Button>

                <Button ToolTip.Tip="Save (Ctrl+S)"
                        Command="{Binding SaveConnectionFileCommand}"
                        Padding="8,3">
                    <TextBlock Text="Save" FontSize="12"/>
                </Button>

                <Button ToolTip.Tip="Edit the selected connection or folder (Ctrl+E)"
                        Command="{Binding ConnectionTree.EditSelectedCommand}"
                        Padding="8,3">
                    <TextBlock Text="Edit" FontSize="12"/>
                </Button>

                <!-- Vertical separator -->
                <Border Width="1" Background="{DynamicResource Border0Brush}" Margin="4,2"/>

                <!-- Quick connect bar -->
                <TextBlock Text="Quick Connect:"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Width="200"
                         Text="{Binding QuickConnectHost}"
                         Watermark="host[:port]"
                         FontSize="12"
                         x:Name="QuickConnectHostBox"/>
                <ComboBox Width="100"
                          ItemsSource="{Binding QuickConnectProtocols}"
                          SelectedItem="{Binding QuickConnectProtocol}"
                          FontSize="12"/>
                <Button Padding="8,3"
                        Classes="accent"
                        Command="{Binding QuickConnectCommand}"
                        ToolTip.Tip="Connect (Enter)">
                    <TextBlock Text="Connect" FontSize="12"/>
                </Button>

                <Border Width="1" Background="{DynamicResource Border0Brush}" Margin="4,2"/>
                <views:ExternalToolsToolbar/>

            </StackPanel>
        </Border>

        <!-- MULTI-SSH TOOLBAR -->
        <!-- Not Classes="toolbar": Options > "show toolbar" toggles those. -->
        <Border DockPanel.Dock="Top" x:Name="MultiSshBar" Background="{DynamicResource AppBg2Brush}" Padding="4,2"
                IsVisible="{Binding IsMultiSshToolbarVisible}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Multi SSH:" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="MultiSshBox"
                         Width="420"
                         FontSize="12"
                         Text="{Binding MultiSsh.CommandText}"
                         Watermark="Type a command; Enter sends it to every open terminal session"
                         ToolTip.Tip="Enter sends the line, Up/Down browse the history, Ctrl+letter sends a control key (Ctrl+C)"/>
                <ComboBox Width="130" FontSize="12"
                          ItemsSource="{Binding MultiSsh.ScopeChoices}"
                          SelectedItem="{Binding MultiSsh.SelectedScope}"/>
                <TextBlock Text="{Binding MultiSsh.TargetSummary, StringFormat='→ {0}'}" FontSize="12"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <Grid ColumnDefinitions="Auto,16,*,Auto,16,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding ActiveConnectionCount, StringFormat='Active connections: {0}'}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding FileStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="● Unsaved changes"
                           IsVisible="{Binding ConnectionTree.IsDirty}"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip.Tip="The connection file has changes that are not saved (Ctrl+S)"/>
                <TextBlock Grid.Column="5"
                           Text="mRemoteNG 1.78.2-dev (Avalonia)"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT — Splitter Layout -->
        <Grid x:Name="MainGrid" ColumnDefinitions="280,4,*" RowDefinitions="*,4,160">

            <!-- LEFT: Connection Tree -->
            <Border x:Name="TreePanel"
                    Grid.Column="0" Grid.RowSpan="3"
                    BorderBrush="{DynamicResource Border0Brush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="panel-header">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="CONNECTIONS"
                                       Classes="section-header"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="&#x1F4C1;"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextLinkBrush}"
                                    ToolTip.Tip="New folder"
                                    Command="{Binding ConnectionTree.NewFolderCommand}"/>
                            <Button Grid.Column="2"
                                    Content="+"
                                    FontSize="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#4caf50"
                                    ToolTip.Tip="New connection"
                                    Command="{Binding NewConnectionCommand}"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="6,4" Background="{DynamicResource AppBg0Brush}">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding ConnectionTree.SearchFilter}"
                                 Watermark="Search name, host, description... (Ctrl+F)"
                                 FontSize="12"
                                 Background="{DynamicResource AppBg2Brush}"
                                 BorderThickness="0">
                            <TextBox.InnerRightContent>
                                <Button Content="✕"
                                        FontSize="10"
                                        Padding="6,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        ToolTip.Tip="Clear search (Esc)"
                                        IsVisible="{Binding ConnectionTree.SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Command="{Binding ConnectionTree.ClearSearchCommand}"/>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </Border>

                    <views:ConnectionTreeView DataContext="{Binding ConnectionTree}"/>
                </DockPanel>
            </Border>

            <!-- COLUMN SPLITTER -->
            <GridSplitter x:Name="TreeSplitter"
                          Grid.Column="1" Grid.RowSpan="3"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- CENTER: Session panels -->
            <Border Grid.Column="2" Grid.Row="0" Background="{DynamicResource AppBg0Brush}">
                <Grid>
                    <!-- Empty state (no sessions, single panel) -->
                    <StackPanel x:Name="EmptySessionsPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="No active sessions"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Double-click a connection to start a session"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <Button Content="Quick Connect..."
                                Classes="accent"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Command="{Binding OpenQuickConnectDialogCommand}"/>
                    </StackPanel>

                    <!-- Named session panels: tabbed, side by side or stacked; floating ones get their own window -->
                    <sessions:SessionAreaView x:Name="SessionArea" DataContext="{Binding Sessions}" IsVisible="False"/>
                </Grid>
            </Border>

            <!-- ROW SPLITTER -->
            <GridSplitter x:Name="BottomSplitter"
                          Grid.Column="2" Grid.Row="1"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Height="4"/>

            <!-- BOTTOM: Tabbed panel (Log / Terminal / Debug Console) -->
            <Border x:Name="BottomPanel"
                    Grid.Column="2" Grid.Row="2"
                    BorderBrush="{DynamicResource Border0Brush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppBg0Brush}">
                <TabControl x:Name="BottomTabs" FontSize="12">

                    <!-- Log Tab -->
                    <TabItem Header="Log">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,2,8,2">
                                <Button Content="Copy" Padding="6,1" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Click="OnCopyLog"/>
                                <Button Content="Clear" Padding="6,1" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Click="OnClearLog"/>
                            </StackPanel>
                            <ScrollViewer x:Name="LogScroller">
                                <ItemsControl ItemsSource="{Binding LogPanel.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dock:LogEntry">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,1">
                                                <TextBlock Text="{Binding FormattedTime}"
                                                           FontFamily="Consolas,Cascadia Code,monospace"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding LevelIcon}" FontSize="11"/>
                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="Consolas,Cascadia Code,monospace"
                                                           FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Local Terminal Tab -->
                    <TabItem Header="Terminal">
                        <Border x:Name="LocalTerminalHost" Background="{DynamicResource AppBg0Brush}"/>
                    </TabItem>

                    <!-- Debug Console Tab -->
                    <TabItem Header="Debug Console">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,2,8,2">
                                <Button Content="Copy" Padding="6,1" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Click="OnCopyDebug"/>
                                <Button Content="Clear" Padding="6,1" FontSize="11"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Click="OnClearDebug"/>
                            </StackPanel>
                            <ScrollViewer x:Name="DebugScroller">
                                <ItemsControl ItemsSource="{Binding DebugConsole.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dock:LogEntry">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,1">
                                                <TextBlock Text="{Binding FormattedTime}"
                                                           FontFamily="Consolas,Cascadia Code,monospace"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding LevelIcon}" FontSize="11"/>
                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="Consolas,Cascadia Code,monospace"
                                                           FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </Border>

        </Grid>

    </DockPanel>
</Window>
