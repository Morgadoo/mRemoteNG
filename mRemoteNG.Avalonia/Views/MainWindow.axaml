<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:views="using:mRemoteNG.Avalonia.Views"
        x:Class="mRemoteNG.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Status bar style -->
        <Style Selector="Border.statusbar">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <!-- Toolbar style -->
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ═══ MENU BAR ═══ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Connection" Command="{Binding NewConnectionCommand}" />
                <Separator/>
                <MenuItem Header="_Open Connection File..." Command="{Binding OpenConnectionFileCommand}" />
                <MenuItem Header="_Save Connection File" Command="{Binding SaveConnectionFileCommand}" />
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Connection Tree" />
                <MenuItem Header="Log / Errors" />
                <Separator/>
                <MenuItem Header="Reset Layout" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Options..." Command="{Binding OpenOptionsCommand}" />
                <Separator/>
                <MenuItem Header="External Tools" />
                <MenuItem Header="Port Scanner" />
                <MenuItem Header="SSH File Transfer" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About mRemoteNG..." Command="{Binding AboutCommand}" />
                <MenuItem Header="Check for Updates..." />
                <Separator/>
                <MenuItem Header="GitHub Repository" />
                <MenuItem Header="Documentation" />
            </MenuItem>
        </Menu>

        <!-- ═══ TOOLBAR ═══ -->
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button ToolTip.Tip="New Connection" Padding="6,2">
                    <TextBlock Text="+ New" />
                </Button>
                <Button ToolTip.Tip="Open Connection File" Padding="6,2">
                    <TextBlock Text="Open" />
                </Button>
                <Separator/>
                <!-- Quick connect bar -->
                <TextBlock Text="Quick Connect:" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox Width="160" Watermark="host[:port]" />
                <ComboBox Width="80" SelectedIndex="0">
                    <ComboBoxItem>SSH</ComboBoxItem>
                    <ComboBoxItem>RDP</ComboBoxItem>
                    <ComboBoxItem>VNC</ComboBoxItem>
                    <ComboBoxItem>Telnet</ComboBoxItem>
                </ComboBox>
                <Button Padding="6,2">Connect</Button>
            </StackPanel>
        </Border>

        <!-- ═══ STATUS BAR ═══ -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding ActiveConnectionCount, StringFormat='Active connections: {0}'}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#a0a0a0"/>
                <TextBlock Grid.Column="1"
                           Text="mRemoteNG 1.78.2-dev"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#606060"
                           Margin="0,0,8,0"/>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT AREA ═══ -->
        <!-- Phase 2: Replace with Dock.Avalonia DockControl for full docking support -->
        <Grid ColumnDefinitions="280,Auto,*">

            <!-- LEFT: Connection Tree Panel -->
            <Border Grid.Column="0" BorderBrush="#3f3f46" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#252526" Padding="8,6">
                        <TextBlock Text="CONNECTIONS" FontSize="11" FontWeight="Bold"
                                   Foreground="#a0a0a0" LetterSpacing="1"/>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="#1e1e1e" Padding="4,4">
                        <TextBox Watermark="Search connections..."
                                 Text="{Binding ConnectionTree.SearchFilter}"
                                 FontSize="12"/>
                    </Border>
                    <views:ConnectionTreeView DataContext="{Binding ConnectionTree}"/>
                </DockPanel>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" Background="#3f3f46"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

            <!-- RIGHT: Connection Tabs Area -->
            <Border Grid.Column="2" Background="#1e1e1e">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2d2d2d" Padding="8,6">
                        <TextBlock Text="CONNECTION SESSIONS" FontSize="11" FontWeight="Bold"
                                   Foreground="#a0a0a0" LetterSpacing="1"/>
                    </Border>
                    <!-- Phase 2: Replace with ConnectionTabHost containing embedded protocol views -->
                    <Border>
                        <TextBlock Text="No active connections.&#10;&#10;Double-click a connection in the tree to connect."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#555555"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>

        </Grid>

    </DockPanel>
</Window>
