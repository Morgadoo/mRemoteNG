<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             xmlns:conv="using:mRemoteNG.Avalonia.Converters"
             xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
             x:Class="mRemoteNG.Avalonia.Views.Shell.CommandPalette"
             x:DataType="vm:CommandPaletteViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Command palette (docs/design-system.md §8): Ctrl+K / Ctrl+Shift+P. Clicking outside closes it. -->
    <Panel>
        <Border x:Name="Backdrop" Background="Transparent"/>

        <Border x:Name="Card" Classes="elevated"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="16,12,16,16"
                Width="640"
                ClipToBounds="True">
            <DockPanel>
                <!-- Search -->
                <Border DockPanel.Dock="Top" Height="48"
                        BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <mi:MaterialIcon Kind="Magnify" Width="20" Height="20" Margin="16,0,0,0"
                                         Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox x:Name="QueryBox" Grid.Column="1" Classes="bare palette-query"
                                 Text="{Binding Query}"
                                 Watermark="{l:Tr ShellPaletteWatermark}"/>
                        <Border Grid.Column="2" Classes="keycap" Margin="0,0,14,0">
                            <TextBlock Text="Esc"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Key hints -->
                <Border DockPanel.Dock="Bottom" Height="32" Padding="14,0"
                        Background="{DynamicResource AppBg0Brush}"
                        BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="keycap"><mi:MaterialIcon Kind="ArrowUp" Width="10" Height="10"/></Border>
                            <Border Classes="keycap"><mi:MaterialIcon Kind="ArrowDown" Width="10" Height="10"/></Border>
                            <TextBlock Classes="caption" Text="{l:Tr ShellPaletteHintNavigate}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="keycap"><TextBlock Text="Enter"/></Border>
                            <TextBlock Classes="caption" Text="{l:Tr ShellPaletteHintOpen}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="keycap"><TextBlock Text="Ctrl"/></Border>
                            <Border Classes="keycap"><TextBlock Text="Enter"/></Border>
                            <TextBlock Classes="caption" Text="{l:Tr ShellPaletteHintOptions}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Panel>
                    <TextBlock Classes="caption" Text="{l:Tr ShellPaletteNoMatches}"
                               IsVisible="{Binding !HasResults}"
                               HorizontalAlignment="Center" Margin="0,20"/>
                    <ListBox x:Name="ResultsList" Classes="palette"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding Selected}"
                             IsVisible="{Binding HasResults}"
                             MaxHeight="400"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteItem">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="36">
                                    <!-- Icon: the connection's glyph in its protocol colour, or the command's -->
                                    <Panel Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <mi:MaterialIcon IsVisible="{Binding IsConnection}"
                                                         Kind="{Binding Connection, Converter={x:Static conv:ConnectionConverters.Icon}}"
                                                         Foreground="{Binding Connection, Converter={x:Static conv:ConnectionConverters.Brush}}"/>
                                        <mi:MaterialIcon IsVisible="{Binding IsCommand}" Kind="{Binding CommandIcon}"
                                                         Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Panel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="300"
                                                   VerticalAlignment="Center"/>
                                        <mi:MaterialIcon Kind="History" Width="12" Height="12" IsVisible="{Binding IsRecent}"
                                                         Foreground="{DynamicResource TextMutedBrush}"
                                                         ToolTip.Tip="{l:Tr ShellRecent}"/>
                                        <mi:MaterialIcon Kind="Star" Width="12" Height="12" IsVisible="{Binding IsFavorite}"
                                                         Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Classes="mono muted" Text="{Binding Host}" IsVisible="{Binding HasHost}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="caption muted" Text="{Binding Detail}"
                                               IsVisible="{Binding HasDetail}"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <Panel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <ctl:ProtocolChip Protocol="{Binding Protocol}" IsVisible="{Binding IsConnection}"/>
                                        <ItemsControl ItemsSource="{Binding ShortcutKeys}" IsVisible="{Binding HasShortcut}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Classes="keycap"><TextBlock Text="{Binding}"/></Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
