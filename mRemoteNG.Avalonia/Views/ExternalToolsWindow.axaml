<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:tools="using:mRemoteNG.Core.Tools"
        x:Class="mRemoteNG.Avalonia.Views.ExternalToolsWindow"
        x:DataType="vm:ExternalToolsWindowViewModel"
        Classes="dialog"
        Title="{l:Tr ExternalTools}"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Icon="avares://mRemoteNG.Avalonia/Assets/Icons/mRemoteNG.ico">

    <Window.Styles>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <ctl:DialogHeader Icon="ToolboxOutline" Title="{l:Tr ExternalTools}" Subtitle="{Binding TargetDescription}"/>

        <Grid Grid.Row="1" ColumnDefinitions="280,16,*" Margin="24,20,24,24">

            <!-- Tool list -->
            <Border Classes="card" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="panel-header" Background="Transparent"
                            BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="{l:Tr ExternalTools, Upper=True}" Classes="overline" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Classes="icon" Command="{Binding AddCommand}" ToolTip.Tip="{l:Tr AddANewTool}">
                                <mi:MaterialIcon Kind="Plus"/>
                            </Button>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding DuplicateCommand}" ToolTip.Tip="{l:Tr Duplicate}">
                                <mi:MaterialIcon Kind="ContentCopy"/>
                            </Button>
                            <Button Grid.Column="3" Classes="icon" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:Tr MoveUp}">
                                <mi:MaterialIcon Kind="ArrowUp"/>
                            </Button>
                            <Button Grid.Column="4" Classes="icon" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:Tr MoveDown}">
                                <mi:MaterialIcon Kind="ArrowDown"/>
                            </Button>
                            <Button Grid.Column="5" Classes="icon" Command="{Binding DeleteCommand}" ToolTip.Tip="{l:Tr _Delete, Suffix='…'}">
                                <mi:MaterialIcon Kind="TrashCanOutline"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ListBox x:Name="ToolList" ItemsSource="{Binding Tools}" SelectedItem="{Binding Selected}"
                             BorderThickness="0" CornerRadius="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="tools:ExternalTool">
                                <Grid ColumnDefinitions="Auto,10,*" Margin="0,6">
                                    <Border Classes="icon-tile neutral" Width="28" Height="28" CornerRadius="6">
                                        <mi:MaterialIcon Kind="Application" Width="16" Height="16"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}" Classes="caption mono" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Properties of the selected tool -->
            <Border Grid.Column="2" Classes="card" Padding="0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Margin="20" IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{l:Tr ExternalToolProperties, English='Tool properties'}" Classes="h2"/>

                        <Grid ColumnDefinitions="*,12,200">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{l:Tr DisplayName, English='Display name'}"/>
                                <TextBox x:Name="DisplayNameBox" Text="{Binding Selected.DisplayName, FallbackValue=''}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="{l:Tr OperatingSystem}"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Platforms}"
                                          SelectedItem="{Binding Selected.Platform, FallbackValue={x:Static tools:ExternalToolPlatform.Any}}"
                                          ToolTip.Tip="{l:Tr ToolsForAnotherOperatingSystemStayIn}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{l:Tr Filename}"/>
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox x:Name="FileNameBox" Classes="mono" Text="{Binding Selected.FileName, FallbackValue=''}"
                                         Watermark="{l:Tr ProgramNameOrPathEGPing}"/>
                                <Button Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowseFileName"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="field-label" Text="{l:Tr Arguments}"/>
                            <TextBox x:Name="ArgumentsBox" Classes="mono" Text="{Binding Selected.Arguments, FallbackValue=''}"
                                     Watermark="e.g. -e ssh %USERNAME%@%HOSTNAME%"/>
                            <!-- Variables: click to insert at the caret -->
                            <ItemsControl x:Name="VariableChips" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Classes="chip" Content="{Binding}" Click="OnInsertVariable" Focusable="False"
                                                ToolTip.Tip="{l:Tr InsertVariable}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel>
                                <TextBlock Classes="field-label" Text="{l:Tr WorkingDirColumnHeader}"/>
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <TextBox Classes="mono" Text="{Binding Selected.WorkingDir, FallbackValue=''}" Watermark="{l:Tr Optional}"/>
                                    <Button Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowseWorkingDir"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="{l:Tr Icon}"/>
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <TextBox Classes="mono" Text="{Binding Selected.IconPath, FallbackValue=''}"
                                             Watermark="{l:Tr OptionalImageFilePNGICO}"/>
                                    <Button Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowseIcon"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <WrapPanel>
                            <CheckBox Classes="switch" Margin="0,0,24,8" Content="{l:Tr WaitForExit}"
                                      IsChecked="{Binding Selected.WaitForExit, FallbackValue=False}"
                                      IsEnabled="{Binding !Selected.TryIntegrate, FallbackValue=True}"
                                      ToolTip.Tip="{l:Tr WaitUntilTheProgramExitsEG}"/>
                            <CheckBox Classes="switch" Margin="0,0,24,8" Content="{l:Tr TryToIntegrate}"
                                      IsChecked="{Binding Selected.TryIntegrate, FallbackValue=False}"
                                      ToolTip.Tip="{l:Tr ShowTheProgramSWindowInsideA}"/>
                            <CheckBox Classes="switch" Margin="0,0,24,8" Content="{l:Tr ShowOnToolbar, English='Show on toolbar'}"
                                      IsChecked="{Binding Selected.ShowOnToolbar, FallbackValue=False}"/>
                            <CheckBox Classes="switch" Margin="0,0,24,8" Content="{l:Tr RunElevated}"
                                      IsChecked="{Binding Selected.RunElevated, FallbackValue=False}"
                                      ToolTip.Tip="{l:Tr WindowsUACPromptLinuxPkexecMacOSAdministrator}"/>
                        </WrapPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{l:Tr Command}" Classes="h2"/>
                            <Border Classes="well">
                                <SelectableTextBlock x:Name="PreviewText" Text="{Binding Preview}" Classes="mono" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding VariablesHelp}" Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Classes="dialog-footer">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Command="{Binding LaunchCommand}" ToolTip.Tip="{l:Tr RunTheSelectedToolAsEditedFor}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Play"/>
                        <TextBlock Text="{l:Tr _Launch}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0"
                           TextWrapping="Wrap" Classes="status caption" Classes.error="{Binding StatusIsError}"/>
                <StackPanel Grid.Column="2" Classes="dialog-actions">
                    <Button Content="{l:Tr _Cancel}" IsCancel="True" Command="{Binding CancelCommand}"/>
                    <Button Content="{l:Tr Save}" Classes="accent" IsDefault="True" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
