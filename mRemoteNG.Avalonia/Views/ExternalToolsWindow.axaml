<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:mRemoteNG.Avalonia.Localization"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:tools="using:mRemoteNG.Core.Tools"
        x:Class="mRemoteNG.Avalonia.Views.ExternalToolsWindow"
        x:DataType="vm:ExternalToolsWindowViewModel"
        Title="{l:Tr ExternalTools}"
        Width="900"
        Height="620"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Icon="avares://mRemoteNG.Avalonia/Assets/Icons/mRemoteNG.ico">

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="260,*" Margin="16,16,16,8">

            <!-- Left: tool list -->
            <Border Classes="card" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr ExternalTools}" Classes="section-header" Margin="0,0,0,8"/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <Button Margin="0,4,6,0" Content="{l:Tr Add}" Command="{Binding AddCommand}" ToolTip.Tip="{l:Tr AddANewTool}"/>
                        <Button Margin="0,4,6,0" Content="{l:Tr Duplicate}" Command="{Binding DuplicateCommand}"/>
                        <Button Margin="0,4,6,0" Content="{l:Tr _Delete}" Command="{Binding DeleteCommand}"/>
                        <Button Margin="0,4,6,0" Content="▲" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:Tr MoveUp}"/>
                        <Button Margin="0,4,6,0" Content="▼" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:Tr MoveDown}"/>
                    </WrapPanel>
                    <ListBox x:Name="ToolList" ItemsSource="{Binding Tools}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="tools:ExternalTool">
                                <StackPanel Spacing="2" Margin="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: properties of the selected tool -->
            <Border Grid.Column="1" Classes="card" Margin="8,0,0,0">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l:Tr ExternalToolProperties, English='Tool Properties'}" Classes="section-header"/>

                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid.Styles>
                                <Style Selector="Grid > :is(Control)">
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                </Style>
                            </Grid.Styles>
                            <TextBlock Grid.Row="0" Text="{l:Tr DisplayName, English='Display name'}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DisplayNameBox"
                                     Text="{Binding Selected.DisplayName, FallbackValue=''}"/>

                            <TextBlock Grid.Row="1" Text="{l:Tr Filename}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FileNameBox"
                                     Text="{Binding Selected.FileName, FallbackValue=''}"
                                     Watermark="{l:Tr ProgramNameOrPathEGPing}"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowseFileName"/>

                            <TextBlock Grid.Row="2" Text="{l:Tr Arguments}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ArgumentsBox"
                                     Text="{Binding Selected.Arguments, FallbackValue=''}"
                                     Watermark="e.g. -e ssh %USERNAME%@%HOSTNAME%"/>

                            <TextBlock Grid.Row="3" Text="{l:Tr WorkingDirColumnHeader}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding Selected.WorkingDir, FallbackValue=''}"
                                     Watermark="{l:Tr Optional}"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowseWorkingDir"/>

                            <TextBlock Grid.Row="4" Text="{l:Tr Icon}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding Selected.IconPath, FallbackValue=''}"
                                     Watermark="{l:Tr OptionalImageFilePNGICO}"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="{l:Tr _Browse, English='Browse…'}" Click="OnBrowseIcon"/>

                            <TextBlock Grid.Row="5" Text="{l:Tr OperatingSystem}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" MinWidth="160"
                                      ItemsSource="{Binding Platforms}"
                                      SelectedItem="{Binding Selected.Platform, FallbackValue={x:Static tools:ExternalToolPlatform.Any}}"
                                      ToolTip.Tip="{l:Tr ToolsForAnotherOperatingSystemStayIn}"/>
                        </Grid>

                        <WrapPanel IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <CheckBox Margin="0,0,18,4" Content="{l:Tr WaitForExit}"
                                      IsChecked="{Binding Selected.WaitForExit, FallbackValue=False}"
                                      IsEnabled="{Binding !Selected.TryIntegrate, FallbackValue=True}"
                                      ToolTip.Tip="{l:Tr WaitUntilTheProgramExitsEG}"/>
                            <CheckBox Margin="0,0,18,4" Content="{l:Tr TryToIntegrate}"
                                      IsChecked="{Binding Selected.TryIntegrate, FallbackValue=False}"
                                      ToolTip.Tip="{l:Tr ShowTheProgramSWindowInsideA}"/>
                            <CheckBox Margin="0,0,18,4" Content="{l:Tr ShowOnToolbar, English='Show on toolbar'}"
                                      IsChecked="{Binding Selected.ShowOnToolbar, FallbackValue=False}"/>
                            <CheckBox Margin="0,0,18,4" Content="{l:Tr RunElevated}"
                                      IsChecked="{Binding Selected.RunElevated, FallbackValue=False}"
                                      ToolTip.Tip="{l:Tr WindowsUACPromptLinuxPkexecMacOSAdministrator}"/>
                        </WrapPanel>

                        <TextBlock Text="{l:Tr Command}" Classes="section-header" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding TargetDescription}" Opacity="0.75" TextWrapping="Wrap"/>
                        <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="1" Padding="8,6" CornerRadius="3">
                            <SelectableTextBlock x:Name="PreviewText" Text="{Binding Preview}" FontFamily="monospace"
                                                 TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="{Binding VariablesHelp}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Button bar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="{l:Tr _Launch}" MinWidth="80" Command="{Binding LaunchCommand}"
                        ToolTip.Tip="{l:Tr RunTheSelectedToolAsEditedFor}"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0"
                           TextWrapping="Wrap" Classes.error="{Binding StatusIsError}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock.error">
                            <Setter Property="Foreground" Value="#f44336"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr _Cancel}" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}"/>
                    <Button Content="{l:Tr Save}" Classes="accent" MinWidth="80" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
