<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:mRemoteNG.Avalonia.Localization"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             xmlns:ctl="using:mRemoteNG.Avalonia.Controls"
             x:Class="mRemoteNG.Avalonia.Views.ConnectionTreeView"
             x:DataType="vm:ConnectionTreeViewModel">

    <UserControl.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:ConnectionNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
        </Style>
        <Style Selector="TreeViewItem.drop-into /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>
        <Style Selector="TreeViewItem.drop-before /template/ Border#PART_LayoutRoot">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBox.rename">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </UserControl.Styles>

    <TreeView x:Name="Tree"
              ItemsSource="{Binding Nodes}"
              SelectedItem="{Binding SelectedNode}"
              DoubleTapped="OnTreeDoubleTapped"
              DragDrop.AllowDrop="True"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Background="{DynamicResource AppBg0Brush}">

        <TreeView.ContextMenu>
            <ContextMenu x:Name="TreeMenu">
                <MenuItem Header="{l:Tr Connect}" Command="{Binding ConnectSelectedCommand}" InputGesture="Enter"/>
                <MenuItem x:Name="ExternalToolsMenuItem" Header="{l:Tr ExternalTools}"/>
                <MenuItem Header="{l:Tr ConnectWithOptions}">
                    <MenuItem Header="{l:Tr ConnectWithOptions, Suffix='...', English='Connect with Options'}" Command="{Binding ConnectWithOptionsCommand}"/>
                    <Separator/>
                    <MenuItem Header="{l:Tr ConnectToConsoleSession}" Command="{Binding ConnectWithPresetCommand}"
                              CommandParameter="{x:Static vm:ConnectPreset.ConsoleSession}"/>
                    <MenuItem Header="{l:Tr DontConnectToConsoleSession}" Command="{Binding ConnectWithPresetCommand}"
                              CommandParameter="{x:Static vm:ConnectPreset.NoConsoleSession}"/>
                    <MenuItem Header="{l:Tr ConnectInFullscreen, English='Connect in full screen'}" Command="{Binding ConnectWithPresetCommand}"
                              CommandParameter="{x:Static vm:ConnectPreset.Fullscreen}"/>
                    <MenuItem Header="{l:Tr ConnectNoCredentials}" Command="{Binding ConnectWithPresetCommand}"
                              CommandParameter="{x:Static vm:ConnectPreset.NoCredentials}"/>
                    <MenuItem Header="{l:Tr ChoosePanelBeforeConnecting, Suffix='...'}" Command="{Binding ConnectChoosePanelCommand}"/>
                    <MenuItem Header="{l:Tr ConnectInViewOnlyMode, English='Connect in view-only mode'}" Command="{Binding ConnectWithPresetCommand}"
                              CommandParameter="{x:Static vm:ConnectPreset.ViewOnly}"/>
                </MenuItem>
                <MenuItem Header="{l:Tr Disconnect}" Command="{Binding DisconnectCommand}"/>
                <MenuItem Header="{l:Tr WakeOnLAN}" Command="{Binding WakeOnLanCommand}"/>
                <Separator/>
                <MenuItem Header="{l:Tr NewConnection, Suffix='...'}" Command="{Binding NewConnectionCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="{l:Tr NewFolder, Suffix='...'}" Command="{Binding NewFolderCommand}"/>
                <Separator/>
                <MenuItem Header="{l:Tr Properties, Suffix='...'}" Command="{Binding EditSelectedCommand}" InputGesture="Ctrl+E"/>
                <MenuItem Header="{l:Tr Rename}" Command="{Binding RenameSelectedCommand}" InputGesture="F2"/>
                <MenuItem Header="{l:Tr Duplicate}" Command="{Binding DuplicateSelectedCommand}" InputGesture="Ctrl+D"/>
                <MenuItem Header="{l:Tr _Delete, Suffix='...'}" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete"/>
                <MenuItem Header="{l:Tr CopyHostname, English='Copy Host Name'}" Command="{Binding CopyHostnameCommand}" InputGesture="Ctrl+Shift+C"/>
                <Separator/>
                <MenuItem Header="{l:Tr Cut}" Command="{Binding CutCommand}" InputGesture="Ctrl+X"/>
                <MenuItem Header="{l:Tr Paste}" Command="{Binding PasteCommand}" InputGesture="Ctrl+V"/>
                <MenuItem Header="{l:Tr MoveUp, English='Move Up'}" Command="{Binding MoveUpCommand}" InputGesture="Ctrl+Up"/>
                <MenuItem Header="{l:Tr MoveDown, English='Move Down'}" Command="{Binding MoveDownCommand}" InputGesture="Ctrl+Down"/>
                <MenuItem Header="{l:Tr Sort}">
                    <MenuItem Header="{l:Tr SortAsc}" Command="{Binding SortAscendingCommand}"/>
                    <MenuItem Header="{l:Tr SortDesc}" Command="{Binding SortDescendingCommand}"/>
                </MenuItem>
                <MenuItem Header="{l:Tr ExpandAll}" Command="{Binding ExpandAllCommand}"/>
                <MenuItem Header="{l:Tr CollapseAll}" Command="{Binding CollapseAllCommand}"/>
                <Separator/>
                <MenuItem Header="{l:Tr Inheritance}">
                    <MenuItem Header="{l:Tr ApplyInheritanceToChildren}" Command="{Binding ApplyInheritanceToChildrenCommand}"/>
                    <MenuItem Header="{l:Tr ApplyDefaultInheritance}" Command="{Binding ApplyDefaultInheritanceCommand}"/>
                    <Separator/>
                    <MenuItem Header="{l:Tr DefaultConnectionProperties, Suffix='...'}" Command="{Binding EditDefaultConnectionCommand}"/>
                </MenuItem>
                <MenuItem Header="{l:Tr RefreshPuTTYSessions}" Command="{Binding RefreshPuttySessionsCommand}"/>
                <MenuItem Header="{l:Tr ConnectionFileProperties, Suffix='...'}" Command="{Binding FilePropertiesCommand}"/>
            </ContextMenu>
        </TreeView.ContextMenu>

        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2"
                            Background="Transparent"
                            Opacity="{Binding DisplayOpacity}"
                            ToolTip.Tip="{Binding ToolTip}">
                    <!-- Folder glyph or connection icon -->
                    <TextBlock Text="{Binding IsFolder, Converter={x:Static vm:BoolToIconConverter.Instance}}"
                               IsVisible="{Binding IsFolder}"
                               FontFamily="Segoe MDL2 Assets,Apple Symbols,Noto Emoji"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextLinkBrush}"/>
                    <Image Source="{Binding IconImage}"
                           IsVisible="{Binding !IsFolder}"
                           Width="16" Height="16"
                           VerticalAlignment="Center"/>

                    <!-- Node name, or the in-place editor while renaming (F2) -->
                    <TextBlock Text="{Binding Name}"
                               IsVisible="{Binding !IsEditing}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontStyle="{Binding IsReadOnly, Converter={x:Static vm:ConnectionTreeConverters.ReadOnlyFontStyle}}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox Classes="rename"
                             Text="{Binding EditName}"
                             IsVisible="{Binding IsEditing}"
                             KeyDown="OnRenameKeyDown"
                             LostFocus="OnRenameLostFocus"
                             PropertyChanged="OnRenameBoxPropertyChanged"/>

                    <!-- Protocol badge (only for leaf nodes) -->
                    <ctl:ProtocolChip Protocol="{Binding Protocol}"
                                      Text="{Binding ProtocolLabel}"
                                      Margin="4,0,0,0"
                                      IsVisible="{Binding !IsFolder}"/>
                </StackPanel>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>

    </TreeView>

</UserControl>
