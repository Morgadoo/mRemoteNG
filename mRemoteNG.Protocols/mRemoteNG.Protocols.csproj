<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>mRemoteNG.Protocols</RootNamespace>
    <AssemblyName>mRemoteNG.Protocols</AssemblyName>
    <Description>mRemoteNG — Cross-platform protocol implementations (SSH, Telnet, RDP, VNC, HTTP)</Description>
    <Version>1.78.2-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- SSH via SSH.NET -->
    <PackageReference Include="SSH.NET" />

    <!-- Avalonia (visual protocol controls) -->
    <PackageReference Include="Avalonia" />

    <!-- JPEG decoding for the VNC Tight encoding (the same SkiaSharp Avalonia renders with) -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />

    <!-- Serial port support -->
    <PackageReference Include="System.IO.Ports" />

    <!-- DI abstractions -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!-- Reactive -->
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mRemoteNG.Platform\mRemoteNG.Platform.csproj" />
    <ProjectReference Include="..\mRemoteNG.Core\mRemoteNG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="mRemoteNG.Tests.CrossPlatform" />
  </ItemGroup>

</Project>
