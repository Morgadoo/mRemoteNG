<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>mRemoteNG.Core</RootNamespace>
    <AssemblyName>mRemoteNG.Core</AssemblyName>
    <Description>Cross-platform core domain and startup abstractions for mRemoteNG.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\mRemoteNG.Platform\mRemoteNG.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <!-- SQL connection storage (legacy tblCons/tblRoot/tblUpdate schema) -->
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- LDAP for the Active Directory importer (wldap32 on Windows, libldap on Linux and macOS) -->
    <PackageReference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>

  <!-- UI strings (see Localization/Localizer.cs). The WinForms app's Language*.resx (English plus 24
       translations) are linked, not copied, so both apps share one set of translations; a satellite
       assembly is produced for every culture. Localization/Strings.resx holds the cross-platform app's
       own strings (English only). -->
  <ItemGroup>
    <InternalsVisibleTo Include="mRemoteNG.Tests.CrossPlatform" />
    <EmbeddedResource Include="..\mRemoteNG\Language\Language*.resx"
                      Link="Localization\Legacy\%(Filename)%(Extension)"
                      LogicalName="mRemoteNG.Core.Localization.Legacy.%(Filename).resources" />
  </ItemGroup>
</Project>
